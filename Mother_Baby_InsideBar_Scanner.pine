// ============================================================
// MOTHER & BABY INSIDE BAR BREAKOUT SCANNER & INDICATOR (v6)
// ============================================================
// Updated with:
// 1. Pivot points for S&R visualization.
// 2. Pre-breakout Setup lines and info panels for Entry/Targets.
// 3. Removed complex arrays of historical labels to optimize.
// ============================================================
//@version=6
indicator("Mother & Baby Inside Bar Scanner", shorttitle="M&B SCAN", overlay=true,
          max_bars_back=300, max_lines_count=200, max_labels_count=500)

// ══════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════
grp_mb     = "══ MOTHER & BABY PATTERN RULES ══"
req_opp_col= input.bool(false, "Require Opposite Colors (Mother/Baby)", group=grp_mb)
filter_doji= input.bool(true,  "Filter Out Doji Mother Candles",         group=grp_mb)
min_m_body = input.float(10.0, "Min Mother Body % of Range",             group=grp_mb, minval=5.0, maxval=50.0)

grp_acc    = "══ ACCURACY FILTERS ══"
filter_ema = input.bool(true,  "EMA Trend Filter", group=grp_acc)
filter_rsi = input.bool(false, "RSI Zone Filter",  group=grp_acc)
filter_vol = input.bool(false, "Volume Expansion", group=grp_acc)
vol_mult   = input.float(1.2,  "Volume Multiplier",group=grp_acc, step=0.1)
filter_htf = input.bool(false, "HTF Alignment",    group=grp_acc)
filter_wicks = input.bool(true, "Wick Rejection Filter", group=grp_acc)

grp_sr     = "══ SUPPORT & RESISTANCE ══"
show_sr    = input.bool(true,  "Show S&R Lines",    group=grp_sr)
sr_lb      = input.int(10, "Pivot Left Bars",  group=grp_sr, minval=3)
sr_rb      = input.int(10, "Pivot Right Bars", group=grp_sr, minval=3)


grp_tp     = "══ SL & TARGET SETTINGS ══"
sl_source  = input.string("Mother Bar Boundary", "Stop Loss Source", options=["Mother Bar Boundary", "Breakout Candle Low/High", "ATR Multiplier"], group=grp_tp)
sl_mult    = input.float(1.5, "ATR SL Multiplier",                       group=grp_tp, minval=0.5, step=0.1)
rr1        = input.float(1.5, "TP1 Risk:Reward (1.5R)",                  group=grp_tp, minval=0.5, step=0.1)
rr2        = input.float(2.5, "TP2 Risk:Reward (2.5R)",                  group=grp_tp, minval=0.5, step=0.1)
rr3        = input.float(4.0, "TP3 Risk:Reward (4.0R)",                  group=grp_tp, minval=0.5, step=0.1)
show_zones = input.bool(true, "Show Active Trade Box",                   group=grp_tp)
show_labels= input.bool(true, "Show Signal Labels",                      group=grp_tp)
zone_ext   = input.int(15,    "Extend Trade Box (bars)",                 group=grp_tp, minval=5)

grp_vis    = "══ VISUALS & DASHBOARD ══"
color_mb_m = input.color(color.new(color.aqua, 20),   "Mother Color", group=grp_vis)
color_mb_b = input.color(color.new(color.yellow, 20), "Baby Color",   group=grp_vis)
show_colors= input.bool(true,  "Highlight Candles",        group=grp_vis)
show_mtf   = input.bool(true,  "Show MTF Dashboard",       group=grp_vis)
mtf_pos    = input.string("Top Right", "Table Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=grp_vis)
show_prep  = input.bool(true, "Show Prep Lines before Breakout", group=grp_vis, tooltip="Shows pending Entry S&R lines.")

grp_al     = "══ ALERTS ══"
al_buy     = input.bool(true, "Alert BUY",  group=grp_al)
al_sell    = input.bool(true, "Alert SELL", group=grp_al)
al_sl      = input.bool(true, "Alert SL",   group=grp_al)
al_tp1     = input.bool(true, "Alert TP1",  group=grp_al)

// ══════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════
_fmt(v)     => str.tostring(v, "#.##")
_dir_col(d) => str.contains(d, "CLOSED (TP)") ? color.new(color.lime, 30) : str.contains(d, "CLOSED (SL)") ? color.new(color.red, 30) : d == "BULL BO" ? color.lime : d == "BEAR BO" ? color.red : d == "INSIDE" ? color.yellow : color.gray
_trend_str(u, dn) => u ? "BULL" : dn ? "BEAR" : "NEUT"
_trend_col(u, dn) => u ? color.lime : dn ? color.red : color.gray

// ══════════════════════════════════════════════════════════
// CORE MOTHER & BABY BREAKOUT LOGIC (Engine for MTF)
// ══════════════════════════════════════════════════════════
f_mb_engine(_req_opp, _f_doji, _m_body_pct, _sl_src, _slm, _rr1, _rr2, _rr3, _f_ema, _f_rsi, _f_vol, _vmult, _f_wicks) =>
    _atr = ta.atr(14)
    _e1  = ta.ema(close, 21)
    _e2  = ta.ema(close, 50)
    _rsi = ta.rsi(close, 14)
    _vm  = ta.sma(volume, 20)

    _ema_bull = _e1 > _e2
    _ema_bear = _e1 < _e2
    _rsi_bull = _rsi > 50
    _rsi_bear = _rsi < 50
    _vol_ok   = volume > _vm * _vmult

    _m_range = high[1] - low[1]
    _m_body  = math.abs(close[1] - open[1])
    _m_body_ratio = _m_range > 0 ? (_m_body / _m_range) * 100 : 0.0

    _is_mother_valid = not _f_doji or (_m_body_ratio >= _m_body_pct)
    _is_baby_inside  = (high <= high[1]) and (low >= low[1])

    _is_opp_color    = (close[1] < open[1] and close > open) or (close[1] > open[1] and close < open)
    _color_valid     = not _req_opp or _is_opp_color
    _is_mb_pattern   = _is_mother_valid and _is_baby_inside and _color_valid

    var float _m_high = na
    var float _m_low  = na
    var bool  _in_ib  = false
    _day_chg     = ta.change(time("D"))
    _is_new_day  = timeframe.isintraday and _day_chg != 0

    var bool _tr_act = false
    var int  _tr_dir = 0
    var string _st   = "NEUTRAL"
    var float  _en = na, var float _sl = na, var float _t1 = na, var float _t2 = na, var float _t3 = na

    if _is_new_day
        _in_ib := false, _m_high := na, _m_low := na
        if _tr_act or _tr_dir != 0
            _tr_act := false, _tr_dir := 0, _st := "CLOSED (PREV DAY)"
        else if _st == "BULL BO" or _st == "BEAR BO" or str.contains(_st, "CLOSED")
            _st := "CLOSED (PREV DAY)"

    if _is_mb_pattern and not _in_ib and not _is_new_day
        _m_high := high[1], _m_low := low[1], _in_ib := true
    else if _in_ib and high <= _m_high and low >= _m_low and not _is_new_day
        _in_ib := true
    else
        if not _is_mb_pattern and not na(_m_high) and (close > _m_high or close < _m_low or high > _m_high or low < _m_low or _is_new_day)
            _in_ib := false

    _bo_rng = high - low
    _valid_buy_wick = not _f_wicks or (_bo_rng > 0 and ((close - low) / _bo_rng) >= 0.5)
    _valid_sel_wick = not _f_wicks or (_bo_rng > 0 and ((high - close) / _bo_rng) >= 0.5)

    _raw_buy  = _in_ib[1] and not _is_new_day and (close > _m_high) and (close > open) and _valid_buy_wick
    _raw_sell = _in_ib[1] and not _is_new_day and (close < _m_low)  and (close < open)  and _valid_sel_wick

    _buy_bo  = _raw_buy and not _tr_act and (_f_ema ? _ema_bull : true) and (_f_rsi ? _rsi_bull : true) and (_f_vol ? _vol_ok : true)
    _sell_bo = _raw_sell and not _tr_act and (_f_ema ? _ema_bear : true) and (_f_rsi ? _rsi_bear : true) and (_f_vol ? _vol_ok : true)

    _sl_dist_b = _sl_src == "Breakout Candle Low/High" ? math.max(close - low, _atr * 0.5) : _sl_src == "ATR Multiplier" ? _slm * _atr : math.max(close - _m_low[1], _atr * 0.5)
    _sl_dist_s = _sl_src == "Breakout Candle Low/High" ? math.max(high - close, _atr * 0.5) : _sl_src == "ATR Multiplier" ? _slm * _atr : math.max(_m_high[1] - close, _atr * 0.5)

    if _buy_bo
        _st := "BULL BO", _en := close, _sl := close - _sl_dist_b
        _t1 := close + _rr1*_sl_dist_b, _t2 := close + _rr2*_sl_dist_b, _t3 := close + _rr3*_sl_dist_b
        _tr_act := true, _tr_dir := 1, _in_ib := false
    else if _sell_bo
        _st := "BEAR BO", _en := close, _sl := close + _sl_dist_s
        _t1 := close - _rr1*_sl_dist_s, _t2 := close - _rr2*_sl_dist_s, _t3 := close - _rr3*_sl_dist_s
        _tr_act := true, _tr_dir := -1, _in_ib := false

    if _tr_act and not _buy_bo and not _sell_bo
        if _tr_dir == 1
            if high >= _t1
                _st := "CLOSED (TP)", _tr_act := false, _tr_dir := 0
            else if low <= _sl
                _st := "CLOSED (SL)", _tr_act := false, _tr_dir := 0
            else if not _ema_bull
                _st := "CLOSED (FLIP)", _tr_act := false, _tr_dir := 0
        else if _tr_dir == -1
            if low <= _t1
                _st := "CLOSED (TP)", _tr_act := false, _tr_dir := 0
            else if high >= _sl
                _st := "CLOSED (SL)", _tr_act := false, _tr_dir := 0
            else if not _ema_bear
                _st := "CLOSED (FLIP)", _tr_act := false, _tr_dir := 0

    if _is_mb_pattern and not _buy_bo and not _sell_bo and not _tr_act
        _st := "INSIDE"

    [ _is_mb_pattern, _buy_bo, _sell_bo, _st, _en, _sl, _t1, _t2, _t3, _is_opp_color, _ema_bull ]

// ══════════════════════════════════════════════════════════
// MULTI-TIMEFRAME ANALYSIS
// ══════════════════════════════════════════════════════════
[mb15, b15, s15, st15, en15, sl15, t1_15, t2_15, t3_15, opp15, up15] = request.security(syminfo.tickerid, "15", f_mb_engine(req_opp_col, filter_doji, min_m_body, sl_source, sl_mult, rr1, rr2, rr3, filter_ema, filter_rsi, filter_vol, vol_mult, filter_wicks), lookahead=barmerge.lookahead_off)
[mb1h, b1h, s1h, st1h, en1h, sl1h, t1_1h, t2_1h, t3_1h, opp1h, up1h] = request.security(syminfo.tickerid, "60", f_mb_engine(req_opp_col, filter_doji, min_m_body, sl_source, sl_mult, rr1, rr2, rr3, filter_ema, filter_rsi, filter_vol, vol_mult, filter_wicks), lookahead=barmerge.lookahead_off)
[mb1d, b1d, s1d, st1d, en1d, sl1d, t1_1d, t2_1d, t3_1d, opp1d, up1d] = request.security(syminfo.tickerid, "D",  f_mb_engine(req_opp_col, filter_doji, min_m_body, sl_source, sl_mult, rr1, rr2, rr3, filter_ema, filter_rsi, filter_vol, vol_mult, filter_wicks), lookahead=barmerge.lookahead_off)
[mb1w, b1w, s1w, st1w, en1w, sl1w, t1_1w, t2_1w, t3_1w, opp1w, up1w] = request.security(syminfo.tickerid, "W",  f_mb_engine(req_opp_col, filter_doji, min_m_body, sl_source, sl_mult, rr1, rr2, rr3, filter_ema, filter_rsi, filter_vol, vol_mult, filter_wicks), lookahead=barmerge.lookahead_off)
[mb1m, b1m, s1m, st1m, en1m, sl1m, t1_1m, t2_1m, t3_1m, opp1m, up1m] = request.security(syminfo.tickerid, "M",  f_mb_engine(req_opp_col, filter_doji, min_m_body, sl_source, sl_mult, rr1, rr2, rr3, filter_ema, filter_rsi, filter_vol, vol_mult, filter_wicks), lookahead=barmerge.lookahead_off)

// ══════════════════════════════════════════════════════════
// CURRENT CHART TIMEFRAME EXECUTION & VISUALS
// ══════════════════════════════════════════════════════════
_atr = ta.atr(14)
_e1  = ta.ema(close, 21)
_e2  = ta.ema(close, 50)
_rsi = ta.rsi(close, 14)
_vm  = ta.sma(volume, 20)

_ema_bull = _e1 > _e2
_ema_bear = _e1 < _e2
_rsi_bull = _rsi > 50
_rsi_bear = _rsi < 50
_vol_ok   = volume > _vm * vol_mult

_is_intraday = timeframe.in_seconds() <= 3600
_htf_bull    = filter_htf ? (_is_intraday ? up1d : _ema_bull) : true
_htf_bear    = filter_htf ? (_is_intraday ? not up1d : _ema_bear) : true

_m_range = high[1] - low[1]
_m_body  = math.abs(close[1] - open[1])
_m_body_ratio = _m_range > 0 ? (_m_body / _m_range) * 100 : 0.0
_is_mother_valid = not filter_doji or (_m_body_ratio >= min_m_body)
_is_baby_inside  = (high <= high[1]) and (low >= low[1])

_is_opp_color  = (close[1] < open[1] and close > open) or (close[1] > open[1] and close < open)
_color_valid   = not req_opp_col or _is_opp_color
_is_mb_pattern = _is_mother_valid and _is_baby_inside and _color_valid

// Chart Candle Coloring
barcolor(show_colors and _is_mb_pattern ? color_mb_b : show_colors and _is_mb_pattern[1] ? color_mb_m : na)

// ══════════════════════════════════════════════════════════
// SIMPLE SUPPORT & RESISTANCE (Last Swing High / Low)
// ══════════════════════════════════════════════════════════
var line _sr_res = na
var line _sr_sup = na
var label _sr_res_lbl = na
var label _sr_sup_lbl = na

float _ph = ta.pivothigh(high, sr_lb, sr_rb)
float _pl = ta.pivotlow(low,  sr_lb, sr_rb)

if show_sr and not na(_ph)
    line.delete(_sr_res)
    label.delete(_sr_res_lbl)
    _sr_res := line.new(bar_index - sr_rb, _ph, bar_index, _ph,
         color=color.new(color.red, 30), width=1, style=line.style_solid, extend=extend.right)
    _sr_res_lbl := label.new(bar_index - sr_rb, _ph, "R " + _fmt(_ph),
         color=color.new(color.red, 70), textcolor=color.red, style=label.style_label_right, size=size.tiny)

if show_sr and not na(_pl)
    line.delete(_sr_sup)
    label.delete(_sr_sup_lbl)
    _sr_sup := line.new(bar_index - sr_rb, _pl, bar_index, _pl,
         color=color.new(color.lime, 30), width=1, style=line.style_solid, extend=extend.right)
    _sr_sup_lbl := label.new(bar_index - sr_rb, _pl, "S " + _fmt(_pl),
         color=color.new(color.lime, 70), textcolor=color.lime, style=label.style_label_right, size=size.tiny)


// ══════════════════════════════════════════════════════════
// TRADE MANAGEMENT VARIABLES
// ══════════════════════════════════════════════════════════
// Trade price levels
var float  _tent = na, var float _tsl = na, var float _ttp1 = na, var float _ttp2 = na, var float _ttp3 = na
var bool   _tp1hit = false, var bool _tp2hit = false, var bool _tp3hit = false, var bool _slhit  = false

// Zone drawing objects
var line _zl_en = na, var line _zl_sl = na, var line _zl_t1 = na, var line _zl_t2 = na, var line _zl_t3 = na
var linefill _zf_sl = na, var linefill _zf_t1 = na, var linefill _zf_t2 = na, var linefill _zf_t3 = na
var label _lb_en = na, var label _lb_sl = na, var label _lb_t1 = na, var label _lb_t2 = na, var label _lb_t3 = na
var line _p_res = na, var line _p_sup = na
var label _p_lbl = na

// Signal label — persistent so we can update text when outcome is known
var label  _sig_lbl     = na
var string _sig_lbl_txt = ""  // tracks current label text so we can append without label.get_text()

_del_zones() =>
    line.delete(_zl_en), line.delete(_zl_sl), line.delete(_zl_t1), line.delete(_zl_t2), line.delete(_zl_t3)
    linefill.delete(_zf_sl), linefill.delete(_zf_t1), linefill.delete(_zf_t2), linefill.delete(_zf_t3)
    label.delete(_lb_en), label.delete(_lb_sl), label.delete(_lb_t1), label.delete(_lb_t2), label.delete(_lb_t3)

_del_prep() =>
    line.delete(_p_res), line.delete(_p_sup), label.delete(_p_lbl)

var float  _m_high = na
var float  _m_low  = na
var bool   _in_ib  = false
var string _tdir   = "NONE"

_chart_day_chg    = ta.change(time("D"))
_is_chart_new_day = timeframe.isintraday and _chart_day_chg != 0

if _is_chart_new_day
    _in_ib := false, _m_high := na, _m_low := na
    _del_prep()
    if _tdir != "NONE"
        // Auto-close any active signal at End-of-Day — mark label as EOD CLOSED
        if not na(_sig_lbl)
            _eod_txt = _sig_lbl_txt + "\n⏹ EOD CLOSED"
            label.set_text(_sig_lbl, _eod_txt)
            label.set_color(_sig_lbl, color.new(color.gray, 30))
            _sig_lbl_txt := _eod_txt
        _del_zones()
        _tdir := "NONE"
        _tp1hit := false, _tp2hit := false, _tp3hit := false, _slhit := false

if _is_mb_pattern and not _in_ib and (_tdir == "NONE") and not _is_chart_new_day
    _m_high := high[1], _m_low := low[1], _in_ib := true
    if show_prep
        _del_prep()
        _p_res := line.new(bar_index-1, _m_high, bar_index+5, _m_high, color=color.aqua, style=line.style_solid, width=2)
        _p_sup := line.new(bar_index-1, _m_low, bar_index+5, _m_low, color=color.orange, style=line.style_solid, width=2)
        
        _b_en = _m_high
        _b_sl = sl_source == "Breakout Candle Low/High" ? _m_low : sl_source == "ATR Multiplier" ? _b_en - (sl_mult * _atr) : _m_low
        _b_t1 = _b_en + rr1 * (_b_en - _b_sl)
        
        _s_en = _m_low
        _s_sl = sl_source == "Breakout Candle Low/High" ? _m_high : sl_source == "ATR Multiplier" ? _s_en + (sl_mult * _atr) : _m_high
        _s_t1 = _s_en - rr1 * (_s_sl - _s_en)
        
        str_msg = "PREP ZONES:\n" + 
                  "LONG Entry: " + _fmt(_b_en) + " | SL: " + _fmt(_b_sl) + " | TP: " + _fmt(_b_t1) + "\n" +
                  "SHORT Entry: " + _fmt(_s_en) + " | SL: " + _fmt(_s_sl) + " | TP: " + _fmt(_s_t1)
                  
        _p_lbl := label.new(bar_index, _m_high, str_msg, yloc=yloc.abovebar, color=color.blue, textcolor=color.white, style=label.style_label_down, size=size.small)

else if _in_ib and high <= _m_high and low >= _m_low and not _is_chart_new_day
    _in_ib := true
    if show_prep and not na(_p_res)
        line.set_x2(_p_res, bar_index+2)
        line.set_x2(_p_sup, bar_index+2)
        label.set_x(_p_lbl, bar_index)
else
    if not na(_m_high) and (close > _m_high or close < _m_low or high > _m_high or low < _m_low or _is_chart_new_day)
        _in_ib := false
        _del_prep()

_bo_rng = high - low
_valid_buy_wick = not filter_wicks or (_bo_rng > 0 and ((close - low) / _bo_rng) >= 0.5)
_valid_sel_wick = not filter_wicks or (_bo_rng > 0 and ((high - close) / _bo_rng) >= 0.5)

_raw_buy  = _in_ib[1] and not _is_chart_new_day and (close > _m_high) and (close > open) and _valid_buy_wick
_raw_sell = _in_ib[1] and not _is_chart_new_day and (close < _m_low)  and (close < open)  and _valid_sel_wick

_buy_sig  = _raw_buy and (_tdir == "NONE") and (filter_ema ? _ema_bull : true) and (filter_rsi ? _rsi_bull : true) and (filter_vol ? _vol_ok : true) and _htf_bull
_sell_sig = _raw_sell and (_tdir == "NONE") and (filter_ema ? _ema_bear : true) and (filter_rsi ? _rsi_bear : true) and (filter_vol ? _vol_ok : true) and _htf_bear

var int _b_since_buy = 999, var int _b_since_sell = 999
if _buy_sig
    _b_since_buy := 0
else
    _b_since_buy += 1
if _sell_sig
    _b_since_sell := 0
else
    _b_since_sell += 1

// Active Trades Plotting — using label.new so tooltip shows Entry/SL/TP when clicked


if _buy_sig
    _tdir := "LONG", _tent := close
    _sl_d = sl_source == "Breakout Candle Low/High" ? math.max(close - low, _atr * 0.5) : sl_source == "ATR Multiplier" ? sl_mult * _atr : math.max(close - _m_low[1], _atr * 0.5)
    _tsl := close - _sl_d, _ttp1 := close + rr1*_sl_d, _ttp2 := close + rr2*_sl_d, _ttp3 := close + rr3*_sl_d
    _tp1hit := false, _tp2hit := false, _tp3hit := false, _slhit := false
    _del_prep()
    // BUY signal label — stored in _sig_lbl so outcome can be updated later
    if show_labels
        _buy_tip = "\ud83d\udfe2 BUY SIGNAL | ACTIVE"
        _buy_tip := _buy_tip + "\nEntry : " + _fmt(close)
        _buy_tip := _buy_tip + "\nSL    : " + _fmt(_tsl)
        _buy_tip := _buy_tip + "\nTP1   : " + _fmt(_ttp1)
        _buy_tip := _buy_tip + "\nTP2   : " + _fmt(_ttp2)
        _buy_tip := _buy_tip + "\nTP3   : " + _fmt(_ttp3)
        _buy_lbl_txt = "BUY ▲ ACTIVE"
        _sig_lbl_txt := _buy_lbl_txt
        _sig_lbl := label.new(bar_index, low, _buy_lbl_txt,
             yloc=yloc.belowbar, style=label.style_label_up,
             color=color.lime, textcolor=color.black, size=size.small,
             tooltip=_buy_tip)
    if show_zones
        _del_zones()
        _x2 = bar_index + zone_ext, _lx = _x2 + 1
        _zl_en := line.new(bar_index, close, _x2, close, color=color.white, width=2)
        _zl_sl := line.new(bar_index, _tsl,  _x2, _tsl,  color=color.red,   width=2)
        _zl_t1 := line.new(bar_index, _ttp1, _x2, _ttp1, color=color.new(color.yellow, 20), width=1)
        _zl_t2 := line.new(bar_index, _ttp2, _x2, _ttp2, color=color.new(color.lime,   20), width=2)
        _zl_t3 := line.new(bar_index, _ttp3, _x2, _ttp3, color=color.new(color.teal,   20), width=2)
        _zf_sl := linefill.new(_zl_sl, _zl_en, color.new(color.red,   96))
        _zf_t1 := linefill.new(_zl_en, _zl_t1, color.new(color.lime,  97))
        _zf_t2 := linefill.new(_zl_t1, _zl_t2, color.new(color.green, 96))
        _zf_t3 := linefill.new(_zl_t2, _zl_t3, color.new(color.teal,  96))
        _lb_en := label.new(_lx, close, "ENTRY " + _fmt(close), style=label.style_label_left, color=color.new(color.gray, 20), textcolor=color.white, size=size.small)
        _lb_sl := label.new(_lx, _tsl,  "SL "    + _fmt(_tsl),  style=label.style_label_left, color=color.new(color.red,  20), textcolor=color.white, size=size.small)
        _lb_t1 := label.new(_lx, _ttp1, "TP1 "   + _fmt(_ttp1), style=label.style_label_left, color=color.new(color.yellow,20), textcolor=color.white, size=size.small)
        _lb_t2 := label.new(_lx, _ttp2, "TP2 "   + _fmt(_ttp2), style=label.style_label_left, color=color.new(color.lime, 20), textcolor=color.white, size=size.small)
        _lb_t3 := label.new(_lx, _ttp3, "TP3 "   + _fmt(_ttp3), style=label.style_label_left, color=color.new(color.teal, 20), textcolor=color.white, size=size.small)

if _sell_sig
    _tdir := "SHORT", _tent := close
    _sl_d = sl_source == "Breakout Candle Low/High" ? math.max(high - close, _atr * 0.5) : sl_source == "ATR Multiplier" ? sl_mult * _atr : math.max(_m_high[1] - close, _atr * 0.5)
    _tsl := close + _sl_d, _ttp1 := close - rr1*_sl_d, _ttp2 := close - rr2*_sl_d, _ttp3 := close - rr3*_sl_d
    _tp1hit := false, _tp2hit := false, _tp3hit := false, _slhit := false
    _del_prep()
    // SELL signal label — stored in _sig_lbl so outcome can be updated later
    if show_labels
        _sell_tip = "\ud83d\udd34 SELL SIGNAL | ACTIVE"
        _sell_tip := _sell_tip + "\nEntry : " + _fmt(close)
        _sell_tip := _sell_tip + "\nSL    : " + _fmt(_tsl)
        _sell_tip := _sell_tip + "\nTP1   : " + _fmt(_ttp1)
        _sell_tip := _sell_tip + "\nTP2   : " + _fmt(_ttp2)
        _sell_tip := _sell_tip + "\nTP3   : " + _fmt(_ttp3)
        _sell_lbl_txt = "SELL ▼ ACTIVE"
        _sig_lbl_txt := _sell_lbl_txt
        _sig_lbl := label.new(bar_index, high, _sell_lbl_txt,
             yloc=yloc.abovebar, style=label.style_label_down,
             color=color.red, textcolor=color.white, size=size.small,
             tooltip=_sell_tip)
    if show_zones
        _del_zones()
        _x2 = bar_index + zone_ext, _lx = _x2 + 1
        _zl_en := line.new(bar_index, close, _x2, close, color=color.white, width=2)
        _zl_sl := line.new(bar_index, _tsl,  _x2, _tsl,  color=color.red,   width=2)
        _zl_t1 := line.new(bar_index, _ttp1, _x2, _ttp1, color=color.new(color.yellow, 20), width=1)
        _zl_t2 := line.new(bar_index, _ttp2, _x2, _ttp2, color=color.new(color.lime,   20), width=2)
        _zl_t3 := line.new(bar_index, _ttp3, _x2, _ttp3, color=color.new(color.teal,   20), width=2)
        _zf_sl := linefill.new(_zl_en, _zl_sl, color.new(color.red,   96))
        _zf_t1 := linefill.new(_zl_t1, _zl_en, color.new(color.lime,  97))
        _zf_t2 := linefill.new(_zl_t2, _zl_t1, color.new(color.green, 96))
        _zf_t3 := linefill.new(_zl_t3, _zl_t2, color.new(color.teal,  96))
        _lb_en := label.new(_lx, close, "ENTRY " + _fmt(close), style=label.style_label_left, color=color.new(color.gray, 20), textcolor=color.white, size=size.small)
        _lb_sl := label.new(_lx, _tsl,  "SL "    + _fmt(_tsl),  style=label.style_label_left, color=color.new(color.red,  20), textcolor=color.white, size=size.small)
        _lb_t1 := label.new(_lx, _ttp1, "TP1 "   + _fmt(_ttp1), style=label.style_label_left, color=color.new(color.yellow,20), textcolor=color.white, size=size.small)
        _lb_t2 := label.new(_lx, _ttp2, "TP2 "   + _fmt(_ttp2), style=label.style_label_left, color=color.new(color.lime, 20), textcolor=color.white, size=size.small)
        _lb_t3 := label.new(_lx, _ttp3, "TP3 "   + _fmt(_ttp3), style=label.style_label_left, color=color.new(color.teal, 20), textcolor=color.white, size=size.small)


// ══════════════════════════════════════════════════════════
// ACTIVE TRADE ZONE MANAGEMENT
// ══════════════════════════════════════════════════════════
if _tdir != "NONE"
    if show_zones and not na(_zl_en) and barstate.islast
        _nx = bar_index + zone_ext
        line.set_x2(_zl_en, _nx), line.set_x2(_zl_sl, _nx), line.set_x2(_zl_t1, _nx), line.set_x2(_zl_t2, _nx), line.set_x2(_zl_t3, _nx)
        if not na(_lb_en)
            label.set_x(_lb_en, _nx + 1), label.set_x(_lb_sl, _nx + 1), label.set_x(_lb_t1, _nx + 1), label.set_x(_lb_t2, _nx + 1), label.set_x(_lb_t3, _nx + 1)

    if _tdir == "LONG"
        // Track TP hits
        if not _tp1hit and high >= _ttp1
            _tp1hit := true
        if not _tp2hit and high >= _ttp2
            _tp2hit := true
        if not _tp3hit and high >= _ttp3
            _tp3hit := true
        // Track SL hit — update signal label immediately
        if not _slhit and low <= _tsl
            _slhit := true
            if not na(_sig_lbl)
                label.set_text(_sig_lbl, "BUY ❌ SL HIT")
                label.set_color(_sig_lbl, color.new(color.red, 20))
        // TP1 reached — update signal label
        if _tp1hit and not _slhit and not na(_sig_lbl)
            label.set_text(_sig_lbl, "BUY ✅ TP HIT")
            label.set_color(_sig_lbl, color.new(color.teal, 10))
        // Close trade on TP1/SL
        if _ema_bear or low <= _tsl or high >= _ttp1
            _del_zones(), _tdir := "NONE"

    if _tdir == "SHORT"
        // Track TP hits
        if not _tp1hit and low <= _ttp1
            _tp1hit := true
        if not _tp2hit and low <= _ttp2
            _tp2hit := true
        if not _tp3hit and low <= _ttp3
            _tp3hit := true
        // Track SL hit — update signal label immediately
        if not _slhit and high >= _tsl
            _slhit := true
            if not na(_sig_lbl)
                label.set_text(_sig_lbl, "SELL ❌ SL HIT")
                label.set_color(_sig_lbl, color.new(color.red, 20))
        // TP1 reached — update signal label
        if _tp1hit and not _slhit and not na(_sig_lbl)
            label.set_text(_sig_lbl, "SELL ✅ TP HIT")
            label.set_color(_sig_lbl, color.new(color.teal, 10))
        // Close trade on TP1/SL
        if _ema_bull or high >= _tsl or low <= _ttp1
            _del_zones(), _tdir := "NONE"

// ══════════════════════════════════════════════════════════
// MTF DASHBOARD TABLE
// ══════════════════════════════════════════════════════════
_tbl_pos = mtf_pos == "Top Right" ? position.top_right : mtf_pos == "Top Left" ? position.top_left : mtf_pos == "Bottom Right" ? position.bottom_right : position.bottom_left
var table _tb = table.new(_tbl_pos, 6, 10, bgcolor=color.new(color.black, 75), border_color=color.new(color.gray, 50), border_width=1, frame_color=color.new(color.gray, 30), frame_width=1)

_row(r, lbl, v15, v1h, v1d, v1w, v1m, c15, c1h, c1d, c1w, c1m) =>
    table.cell(_tb, 0, r, lbl, text_color=color.gray, text_size=size.small, bgcolor=color.new(color.black, 80))
    table.cell(_tb, 1, r, v15, text_color=c15, text_size=size.small, bgcolor=color.new(color.black, 80), text_halign=text.align_right)
    table.cell(_tb, 2, r, v1h, text_color=c1h, text_size=size.small, bgcolor=color.new(color.black, 80), text_halign=text.align_right)
    table.cell(_tb, 3, r, v1d, text_color=c1d, text_size=size.small, bgcolor=color.new(color.black, 80), text_halign=text.align_right)
    table.cell(_tb, 4, r, v1w, text_color=c1w, text_size=size.small, bgcolor=color.new(color.black, 80), text_halign=text.align_right)
    table.cell(_tb, 5, r, v1m, text_color=c1m, text_size=size.small, bgcolor=color.new(color.black, 80), text_halign=text.align_right)

_is_act(st) => st == "BULL BO" or st == "BEAR BO"

if barstate.islast and show_mtf
    _cur_newsig = _buy_sig ? "🔥 BUY (LIVE)" : _b_since_buy <= 5 ? "🔥 BUY (" + str.tostring(_b_since_buy) + "b)" : _sell_sig ? "🔥 SELL (LIVE)" : _b_since_sell <= 5 ? "🔥 SELL (" + str.tostring(_b_since_sell) + "b)" : "-"
    _cur_sigcol = (_buy_sig or _b_since_buy <= 5) ? color.lime : (_sell_sig or _b_since_sell <= 5) ? color.red : color.gray

    table.cell(_tb, 0, 0, "M&B SCAN", text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy,10), text_halign=text.align_center)
    table.cell(_tb, 1, 0, "15m", text_color=color.new(color.aqua, 10), text_size=size.small, bgcolor=color.new(color.navy,30), text_halign=text.align_center)
    table.cell(_tb, 2, 0, "1H",  text_color=color.new(color.purple, 20), text_size=size.small, bgcolor=color.new(color.navy,30), text_halign=text.align_center)
    table.cell(_tb, 3, 0, "1D",  text_color=color.new(color.orange, 20), text_size=size.small, bgcolor=color.new(color.navy,30), text_halign=text.align_center)
    table.cell(_tb, 4, 0, "1W",  text_color=color.new(color.yellow, 20), text_size=size.small, bgcolor=color.new(color.navy,30), text_halign=text.align_center)
    table.cell(_tb, 5, 0, "1M",  text_color=color.new(color.fuchsia,20), text_size=size.small, bgcolor=color.new(color.navy,30), text_halign=text.align_center)

    _row(1, "TREND", _trend_str(up15, not up15), _trend_str(up1h, not up1h), _trend_str(up1d, not up1d), _trend_str(up1w, not up1w), _trend_str(up1m, not up1m), _trend_col(up15, not up15), _trend_col(up1h, not up1h), _trend_col(up1d, not up1d), _trend_col(up1w, not up1w), _trend_col(up1m, not up1m))
    _row(2, "STATUS", st15, st1h, st1d, st1w, st1m, _dir_col(st15), _dir_col(st1h), _dir_col(st1d), _dir_col(st1w), _dir_col(st1m))
    _row(3, "OPP COLOR", opp15 ? "YES 🔥" : "NO", opp1h ? "YES 🔥" : "NO", opp1d ? "YES 🔥" : "NO", opp1w ? "YES 🔥" : "NO", opp1m ? "YES 🔥" : "NO", opp15 ? color.lime : color.gray, opp1h ? color.lime : color.gray, opp1d ? color.lime : color.gray, opp1w ? color.lime : color.gray, opp1m ? color.lime : color.gray)
    _row(4, "ENTRY", _is_act(st15) ? _fmt(en15) : "---", _is_act(st1h) ? _fmt(en1h) : "---", _is_act(st1d) ? _fmt(en1d) : "---", _is_act(st1w) ? _fmt(en1w) : "---", _is_act(st1m) ? _fmt(en1m) : "---", color.white, color.white, color.white, color.white, color.white)
    _row(5, "SL", _is_act(st15) ? _fmt(sl15) : "---", _is_act(st1h) ? _fmt(sl1h) : "---", _is_act(st1d) ? _fmt(sl1d) : "---", _is_act(st1w) ? _fmt(sl1w) : "---", _is_act(st1m) ? _fmt(sl1m) : "---", color.red, color.red, color.red, color.red, color.red)
    _row(6, "TP1", _is_act(st15) ? _fmt(t1_15) : "---", _is_act(st1h) ? _fmt(t1_1h) : "---", _is_act(st1d) ? _fmt(t1_1d) : "---", _is_act(st1w) ? _fmt(t1_1w) : "---", _is_act(st1m) ? _fmt(t1_1m) : "---", color.yellow, color.yellow, color.yellow, color.yellow, color.yellow)
    _row(7, "TP2", _is_act(st15) ? _fmt(t2_15) : "---", _is_act(st1h) ? _fmt(t2_1h) : "---", _is_act(st1d) ? _fmt(t2_1d) : "---", _is_act(st1w) ? _fmt(t2_1w) : "---", _is_act(st1m) ? _fmt(t2_1m) : "---", color.lime, color.lime, color.lime, color.lime, color.lime)
    _row(8, "TP3", _is_act(st15) ? _fmt(t3_15) : "---", _is_act(st1h) ? _fmt(t3_1h) : "---", _is_act(st1d) ? _fmt(t3_1d) : "---", _is_act(st1w) ? _fmt(t3_1w) : "---", _is_act(st1m) ? _fmt(t3_1m) : "---", color.teal, color.teal, color.teal, color.teal, color.teal)
    _row(9, "FRESH SIG", _cur_newsig, b1h ? "BUY" : s1h ? "SELL" : "-", b1d ? "BUY" : s1d ? "SELL" : "-", b1w ? "BUY" : s1w ? "SELL" : "-", b1m ? "BUY" : s1m ? "SELL" : "-", _cur_sigcol, b1h ? color.lime : s1h ? color.red : color.gray, b1d ? color.lime : s1d ? color.red : color.gray, b1w ? color.lime : s1w ? color.red : color.gray, b1m ? color.lime : s1m ? color.red : color.gray)

// ══════════════════════════════════════════════════════════
// REAL-TIME ALERTS
// ══════════════════════════════════════════════════════════
var bool _prev_tp1 = false, var bool _prev_sl  = false
_tp1_edge = _tp1hit and not _prev_tp1
_sl_edge  = _slhit  and not _prev_sl
_prev_tp1 := _tp1hit, _prev_sl  := _slhit

if al_buy and _buy_sig
    alert("M&B BUY | " + syminfo.ticker + " (" + timeframe.period + ") Entry:" + _fmt(close) + " SL:" + _fmt(_tsl), alert.freq_once_per_bar_close)
if al_sell and _sell_sig
    alert("M&B SELL | " + syminfo.ticker + " (" + timeframe.period + ") Entry:" + _fmt(close) + " SL:" + _fmt(_tsl), alert.freq_once_per_bar_close)
if al_tp1 and _tp1_edge
    alert("M&B TP1 HIT | " + syminfo.ticker, alert.freq_once_per_bar)
if al_sl and _sl_edge
    alert("M&B SL HIT | " + syminfo.ticker, alert.freq_once_per_bar)

alertcondition(_buy_sig,  "M&B BUY Breakout",  "Mother & Baby BUY Breakout on {{ticker}}")
alertcondition(_sell_sig, "M&B SELL Breakdown","Mother & Baby SELL Breakdown on {{ticker}}")
alertcondition(_tp1_edge, "M&B TP1 Hit",       "Mother & Baby TP1 Hit on {{ticker}}")
alertcondition(_sl_edge,  "M&B SL Hit",        "Mother & Baby SL Hit on {{ticker}}")
// ══════════════════════════════════════════════════════════
