[fb29,fs29,fp29,fo29,fe29,fa29] = request.security("NSE:DRREDDY1!",    scan_tf, f_mb_light(req_opp_col,filter_doji,min_m_body,filter_ema,filter_wicks), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[fb30,fs30,fp30,fo30,fe30,fa30] = request.security("NSE:EICHERMOT1!",  scan_tf, f_mb_light(req_opp_col,filter_doji,min_m_body,filter_ema,filter_wicks), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[fb31,fs31,fp31,fo31,fe31,fa31] = request.security("NSE:GRASIM1!",     scan_tf, f_mb_light(req_opp_col,filter_doji,min_m_body,filter_ema,filter_wicks), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[fb32,fs32,fp32,fo32,fe32,fa32] = request.security("NSE:HEROMOTOCO1!", scan_tf, f_mb_light(req_opp_col,filter_doji,min_m_body,filter_ema,filter_wicks), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[fb33,fs33,fp33,fo33,fe33,fa33] = request.security("NSE:HINDALCO1!",   scan_tf, f_mb_light(req_opp_col,filter_doji,min_m_body,filter_ema,filter_wicks), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[fb34,fs34,fp34,fo34,fe34,fa34] = request.security("NSE:INDUSINDBK1!", scan_tf, f_mb_light(req_opp_col,filter_doji,min_m_body,filter_ema,filter_wicks), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[fb35,fs35,fp35,fo35,fe35,fa35] = request.security("NSE:JSWSTEEL1!",   scan_tf, f_mb_light(req_opp_col,filter_doji,min_m_body,filter_ema,filter_wicks), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[fb36,fs36,fp36,fo36,fe36,fa36] = request.security("NSE:M_M1!",        scan_tf, f_mb_light(req_opp_col,filter_doji,min_m_body,filter_ema,filter_wicks), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

// Total security calls: 3 (MTF) + 1 (Daily EMA) + 36 (Futures Scanner) = 40 security calls (100% TradingView Free Plan Compliant!)

// ══════════════════════════════════════════════════════════
// MULTI-STOCK FUTURES SCANNER TABLE RENDER
// ══════════════════════════════════════════════════════════
_scan_tbl_pos = scan_pos == "Bottom Right" ? position.bottom_right : scan_pos == "Top Right" ? position.top_right : scan_pos == "Top Left" ? position.top_left : position.bottom_left

var table tb_scan = table.new(_scan_tbl_pos, 10, 24,
     border_width=1, border_color=color.new(color.gray, 75),
     frame_width=1,  frame_color=color.new(#7c4dff, 20))

if barstate.islast and show_scan
    syms  = array.from("RELIANCE FUT","TCS FUT","HDFCBANK FUT","INFY FUT","ICICIBANK FUT","HINDUNILVR FUT","SBIN FUT","BAJFINANCE FUT","BHARTIARTL FUT","KOTAKBANK FUT","LT FUT","HCLTECH FUT","AXISBANK FUT","ASIANPAINT FUT","MARUTI FUT","SUNPHARMA FUT","TITAN FUT","ULTRACEMCO FUT","WIPRO FUT","TATAMOTORS FUT","POWERGRID FUT","NTPC FUT","ONGC FUT","COALINDIA FUT","ADANIPORTS FUT","TECHM FUT","BAJAJFINSV FUT","CIPLA FUT","DRREDDY FUT","EICHERMOT FUT","GRASIM FUT","HEROMOTOCO FUT","HINDALCO FUT","INDUSINDBK FUT","JSWSTEEL FUT","M_M FUT")
    buys  = array.from(fb01,fb02,fb03,fb04,fb05,fb06,fb07,fb08,fb09,fb10,fb11,fb12,fb13,fb14,fb15,fb16,fb17,fb18,fb19,fb20,fb21,fb22,fb23,fb24,fb25,fb26,fb27,fb28,fb29,fb30,fb31,fb32,fb33,fb34,fb35,fb36)
    sells = array.from(fs01,fs02,fs03,fs04,fs05,fs06,fs07,fs08,fs09,fs10,fs11,fs12,fs13,fs14,fs15,fs16,fs17,fs18,fs19,fs20,fs21,fs22,fs23,fs24,fs25,fs26,fs27,fs28,fs29,fs30,fs31,fs32,fs33,fs34,fs35,fs36)
    pats  = array.from(fp01,fp02,fp03,fp04,fp05,fp06,fp07,fp08,fp09,fp10,fp11,fp12,fp13,fp14,fp15,fp16,fp17,fp18,fp19,fp20,fp21,fp22,fp23,fp24,fp25,fp26,fp27,fp28,fp29,fp30,fp31,fp32,fp33,fp34,fp35,fp36)
    opps  = array.from(fo01,fo02,fo03,fo04,fo05,fo06,fo07,fo08,fo09,fo10,fo11,fo12,fo13,fo14,fo15,fo16,fo17,fo18,fo19,fo20,fo21,fo22,fo23,fo24,fo25,fo26,fo27,fo28,fo29,fo30,fo31,fo32,fo33,fo34,fo35,fo36)
    emas  = array.from(fe01,fe02,fe03,fe04,fe05,fe06,fe07,fe08,fe09,fe10,fe11,fe12,fe13,fe14,fe15,fe16,fe17,fe18,fe19,fe20,fe21,fe22,fe23,fe24,fe25,fe26,fe27,fe28,fe29,fe30,fe31,fe32,fe33,fe34,fe35,fe36)
    acts  = array.from(fa01,fa02,fa03,fa04,fa05,fa06,fa07,fa08,fa09,fa10,fa11,fa12,fa13,fa14,fa15,fa16,fa17,fa18,fa19,fa20,fa21,fa22,fa23,fa24,fa25,fa26,fa27,fa28,fa29,fa30,fa31,fa32,fa33,fa34,fa35,fa36)

    act_sym  = array.new_string(0)
    act_type = array.new_int(0) // 1=BUY, 2=SELL, 3=INSIDE, 4=NONE
    act_opp  = array.new_bool(0)
    act_ema  = array.new_bool(0)
    act_act  = array.new_int(0)

    int nb = 0
    int ns = 0
    int ni = 0

    // 1. BUY Signals
    for i = 0 to array.size(syms) - 1
        if array.get(buys, i)
            nb += 1
            array.push(act_sym, array.get(syms, i))
            array.push(act_type, 1)
            array.push(act_opp, array.get(opps, i))
            array.push(act_ema, array.get(emas, i))
            array.push(act_act, array.get(acts, i))

    // 2. SELL Signals
    for i = 0 to array.size(syms) - 1
        if array.get(sells, i)
            ns += 1
            array.push(act_sym, array.get(syms, i))
            array.push(act_type, 2)
            array.push(act_opp, array.get(opps, i))
            array.push(act_ema, array.get(emas, i))
            array.push(act_act, array.get(acts, i))

    // 3. INSIDE Bars
    for i = 0 to array.size(syms) - 1
        if array.get(pats, i) and not array.get(buys, i) and not array.get(sells, i)
            ni += 1
            array.push(act_sym, array.get(syms, i))
            array.push(act_type, 3)
            array.push(act_opp, array.get(opps, i))
            array.push(act_ema, array.get(emas, i))
            array.push(act_act, 0)

    int total_items = array.size(act_sym)
    _ttl = "⚡ FUTURES SCANNER [" + (scan_tf_in == "Chart TF (Auto Sync)" ? timeframe.period : scan_tf_in) + "] | ▲" + str.tostring(nb) + " BUY  ▼" + str.tostring(ns) + " SELL  ◆" + str.tostring(ni) + " INSIDE"

    for c = 0 to 9
        table.cell(tb_scan, c, 0, c == 0 ? _ttl : "", text_color=color.white, bgcolor=color.new(#7c4dff, 20), text_size=size.small, text_halign=text.align_left)

    table.cell(tb_scan, 0, 1, "#",     text_color=color.white, bgcolor=color.new(color.navy, 30), text_size=size.small)
    table.cell(tb_scan, 1, 1, "CONTRACT", text_color=color.white, bgcolor=color.new(color.navy, 30), text_size=size.small, text_halign=text.align_left)
    table.cell(tb_scan, 2, 1, "SIGNAL",text_color=color.white, bgcolor=color.new(color.navy, 30), text_size=size.small)
    table.cell(tb_scan, 3, 1, "TREND", text_color=color.white, bgcolor=color.new(color.navy, 30), text_size=size.small)
    table.cell(tb_scan, 4, 1, "CONF",  text_color=color.yellow,bgcolor=color.new(color.navy, 30), text_size=size.small)

    table.cell(tb_scan, 5, 1, "#",     text_color=color.white, bgcolor=color.new(color.navy, 30), text_size=size.small)
    table.cell(tb_scan, 6, 1, "CONTRACT", text_color=color.white, bgcolor=color.new(color.navy, 30), text_size=size.small, text_halign=text.align_left)
    table.cell(tb_scan, 7, 1, "SIGNAL",text_color=color.white, bgcolor=color.new(color.navy, 30), text_size=size.small)
    table.cell(tb_scan, 8, 1, "TREND", text_color=color.white, bgcolor=color.new(color.navy, 30), text_size=size.small)
    table.cell(tb_scan, 9, 1, "CONF",  text_color=color.yellow,bgcolor=color.new(color.navy, 30), text_size=size.small)

    if total_items == 0
        table.cell(tb_scan, 0, 2, "No active Futures M&B signals.", text_color=color.gray, bgcolor=color.new(color.black, 80), text_size=size.small, text_halign=text.align_left)
        for c = 1 to 9
            table.cell(tb_scan, c, 2, "", bgcolor=color.new(color.black, 80))
    else
        int half = math.ceil(total_items / 2.0)

        for k = 0 to half - 1
            int r = 2 + k

            // LEFT COLUMN
            if k < total_items
                _stk  = array.get(act_sym, k)
                _typ  = array.get(act_type, k)
                _cop  = array.get(act_opp, k)
                _cem  = array.get(act_ema, k)

                // Dedicated Signal Cell Styling
                color _sig_bg  = _typ == 1 ? color.new(#1b5e20, 10)  : _typ == 2 ? color.new(#b71c1c, 10)  : _typ == 3 ? color.new(#e65100, 20)  : color.new(#12122a, 30)
                color _sig_txt = _typ == 1 ? color.new(#00e676, 0)   : _typ == 2 ? color.new(#ff1744, 0)   : _typ == 3 ? color.new(#ffd600, 0)  : color.gray
                string _sig   = _typ == 1 ? "▲ BUY" : _typ == 2 ? "▼ SELL" : _typ == 3 ? "◆ INSIDE" : "— NONE"

                // Dedicated Trend Cell Styling (Vibrant Green for BULL, Red for BEAR)
                color _trd_bg  = _cem ? color.new(#1b5e20, 10) : color.new(#b71c1c, 10)
                color _trd_txt = _cem ? color.new(#00e676, 0)  : color.new(#ff1744, 0)
                string _trd    = _cem ? "🟢 BULL" : "🔴 BEAR"

                // Base Row Background
                color _base_bg = color.new(#12122a, 20)
                color _stk_txt = _typ == 1 ? color.new(#00e676, 0) : _typ == 2 ? color.new(#ff1744, 0) : _typ == 3 ? color.new(#ffd600, 0) : color.white

                table.cell(tb_scan, 0, r, str.tostring(k + 1),  text_color=color.white, bgcolor=_base_bg, text_size=size.small)
                table.cell(tb_scan, 1, r, _stk,                  text_color=_stk_txt,    bgcolor=_base_bg, text_size=size.small, text_halign=text.align_left)
                table.cell(tb_scan, 2, r, _sig,                  text_color=_sig_txt,    bgcolor=_sig_bg,  text_size=size.small)
                table.cell(tb_scan, 3, r, _trd,                  text_color=_trd_txt,    bgcolor=_trd_bg,  text_size=size.small)
                table.cell(tb_scan, 4, r, _cop ? "🔥 HIGH":"—",  text_color=_cop ? color.new(#ffd700, 0) : color.gray, bgcolor=_cop ? color.new(#f57f17, 30) : _base_bg, text_size=size.small)

            // RIGHT COLUMN
            int r_idx = half + k
            if r_idx < total_items
                _stk  = array.get(act_sym, r_idx)
                _typ  = array.get(act_type, r_idx)
                _cop  = array.get(act_opp, r_idx)
                _cem  = array.get(act_ema, r_idx)

                // Dedicated Signal Cell Styling
                color _sig_bg  = _typ == 1 ? color.new(#1b5e20, 10)  : _typ == 2 ? color.new(#b71c1c, 10)  : _typ == 3 ? color.new(#e65100, 20)  : color.new(#12122a, 30)
                color _sig_txt = _typ == 1 ? color.new(#00e676, 0)   : _typ == 2 ? color.new(#ff1744, 0)   : _typ == 3 ? color.new(#ffd600, 0)  : color.gray
                string _sig   = _typ == 1 ? "▲ BUY" : _typ == 2 ? "▼ SELL" : _typ == 3 ? "◆ INSIDE" : "— NONE"

                // Dedicated Trend Cell Styling (Vibrant Green for BULL, Red for BEAR)
                color _trd_bg  = _cem ? color.new(#1b5e20, 10) : color.new(#b71c1c, 10)
                color _trd_txt = _cem ? color.new(#00e676, 0)  : color.new(#ff1744, 0)
                string _trd    = _cem ? "🟢 BULL" : "🔴 BEAR"

                // Base Row Background
                color _base_bg = color.new(#12122a, 20)
                color _stk_txt = _typ == 1 ? color.new(#00e676, 0) : _typ == 2 ? color.new(#ff1744, 0) : _typ == 3 ? color.new(#ffd600, 0) : color.white

                table.cell(tb_scan, 5, r, str.tostring(r_idx + 1), text_color=color.white, bgcolor=_base_bg, text_size=size.small)
                table.cell(tb_scan, 6, r, _stk,                     text_color=_stk_txt,    bgcolor=_base_bg, text_size=size.small, text_halign=text.align_left)
                table.cell(tb_scan, 7, r, _sig,                     text_color=_sig_txt,    bgcolor=_sig_bg,  text_size=size.small)
                table.cell(tb_scan, 8, r, _trd,                     text_color=_trd_txt,    bgcolor=_trd_bg,  text_size=size.small)
                table.cell(tb_scan, 9, r, _cop ? "🔥 HIGH":"—",     text_color=_cop ? color.new(#ffd700, 0) : color.gray, bgcolor=_cop ? color.new(#f57f17, 30) : _base_bg, text_size=size.small)

// ══════════════════════════════════════════════════════════
// REAL-TIME ALERTS FOR FUTURES
// ══════════════════════════════════════════════════════════
var bool _prev_tp1 = false
var bool _prev_sl  = false
_tp1_edge = _tp1hit and not _prev_tp1
_sl_edge  = _slhit  and not _prev_sl
_prev_tp1 := _tp1hit
_prev_sl  := _slhit

if al_buy and _buy_sig
    alert("⚡ FUTURES BUY BREAKOUT | " + syminfo.root + "1! (" + timeframe.period + ") Entry:" + _fmt(close) + " SL:" + _fmt(_tsl), alert.freq_once_per_bar_close)
if al_sell and _sell_sig
    alert("⚡ FUTURES SELL BREAKDOWN | " + syminfo.root + "1! (" + timeframe.period + ") Entry:" + _fmt(close) + " SL:" + _fmt(_tsl), alert.freq_once_per_bar_close)
if al_tp1 and _tp1_edge
    alert("⚡ FUTURES TP1 HIT | " + syminfo.root + "1! @ " + str.tostring(close), alert.freq_once_per_bar)
if al_sl and _sl_edge
    alert("⚡ FUTURES SL HIT | " + syminfo.root + "1! @ " + str.tostring(close), alert.freq_once_per_bar)

alertcondition(_buy_sig,  "Futures BUY Breakout",  "Mother & Baby BUY Breakout on {{ticker}} FUT")
alertcondition(_sell_sig, "Futures SELL Breakdown","Mother & Baby SELL Breakdown on {{ticker}} FUT")
alertcondition(_tp1_edge, "Futures TP1 Hit",       "Mother & Baby TP1 Hit on {{ticker}} FUT")
alertcondition(_sl_edge,  "Futures SL Hit",        "Mother & Baby SL Hit on {{ticker}} FUT")
// ══════════════════════════════════════════════════════════
// END MOTHER & BABY FUTURES SCANNER
// ══════════════════════════════════════════════════════════
