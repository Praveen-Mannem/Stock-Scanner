// ============================================================
// MOTHER & BABY INSIDE BAR FUTURES SCANNER & INDICATOR (v6)
// ============================================================
// Dedicated indicator for NSE Stock Futures (F&O Market)
// Compatible with TradingView FREE Plan (Strict <= 40 security calls limit)
//
// Key Features:
// 1. Automatic Front-Month Continuous Futures Contract Auto-Sync (NSE:ROOT1!)
// 2. Multi-Timeframe Futures Analysis: 15m (Intraday), 1H (Hourly), 1D (Daily)
// 3. 36 Top Liquid NSE F&O Stock Futures Automatic Scanner Table
// 4. Strict Mother & Baby 2-Candle Pattern Rules with Doji Filter
// 5. EMA 21 vs 50 Trend Alignment Filter (Avoid Counter-Trend Fakeouts)
// 6. Breakout Candle Rejection Wick Filter (Close Strength >= 50%)
// 7. Volume Expansion Filter (> 1.2x 20-period Volume SMA)
// 8. High Confidence Setup Tag for Opposite Color Mother/Baby Candles
// 9. Dynamic Trade Zone Box (Entry, SL, TP1 1.5R, TP2 2.5R, TP3 4.0R)
// 10. Real-time Bar-Close Confirmed Alerts
// ============================================================
//@version=6
indicator("Mother & Baby Futures Scanner | F&O", shorttitle="M&B FUT SCAN", overlay=true,
          max_bars_back=300, max_lines_count=100, max_labels_count=100)

// ══════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════
grp_mb     = "══ MOTHER & BABY PATTERN RULES ══"
req_opp_col= input.bool(false, "Require Opposite Colors (Mother/Baby)", group=grp_mb, tooltip="If true, only setups where Mother & Baby have opposite colors are triggered")
filter_doji= input.bool(true,  "Filter Out Doji Mother Candles",         group=grp_mb, tooltip="Invalidates setup if Mother candle body < 10% of range")
min_m_body = input.float(10.0, "Min Mother Body % of Range",             group=grp_mb, minval=5.0, maxval=50.0)

grp_acc    = "══ ACCURACY FILTERS (Reduce False Signals) ══"
filter_ema = input.bool(true,  "EMA Trend Filter (21 > 50 for BUY, 21 < 50 for SELL)", group=grp_acc, tooltip="Buy signals only in uptrend, Sell signals only in downtrend")
filter_rsi = input.bool(false, "RSI Zone Filter (RSI > 50 for BUY, < 50 for SELL)",    group=grp_acc, tooltip="Enable to avoid buying overbought / selling oversold setups")
filter_vol = input.bool(false, "Volume Expansion on Breakout (> 1.2x avg)",            group=grp_acc, tooltip="Require above-average volume on breakout candle")
vol_mult   = input.float(1.2,  "Volume Multiplier",                                    group=grp_acc, minval=1.0, step=0.1)
filter_htf = input.bool(false, "Higher TF Trend Alignment (Daily must agree)",         group=grp_acc, tooltip="For 15m/1H signals: Daily Futures EMA trend must align with signal direction")
filter_wicks = input.bool(true, "Filter Long Rejection Wicks on Breakout",             group=grp_acc, tooltip="Ensures breakout candle closes strong in direction of breakout")

grp_tp     = "══ SL & TARGET SETTINGS ══"
sl_source  = input.string("Mother Bar Boundary", "Stop Loss Source",
             options=["Mother Bar Boundary", "Breakout Candle Low/High", "ATR Multiplier"], group=grp_tp)
sl_mult    = input.float(1.5, "ATR SL Multiplier",                       group=grp_tp, minval=0.5, step=0.1)
rr1        = input.float(1.5, "TP1 Risk:Reward (1.5R)",                  group=grp_tp, minval=0.5, step=0.1)
rr2        = input.float(2.5, "TP2 Risk:Reward (2.5R)",                  group=grp_tp, minval=0.5, step=0.1)
rr3        = input.float(4.0, "TP3 Risk:Reward (4.0R)",                  group=grp_tp, minval=0.5, step=0.1)
show_zones = input.bool(true, "Show Active Trade Box",                   group=grp_tp)
show_labels= input.bool(true, "Show Signal Labels on Chart",             group=grp_tp)
zone_ext   = input.int(15,    "Extend Trade Box (bars)",                 group=grp_tp, minval=5,  maxval=100)

grp_vis    = "══ DISPLAY SETTINGS & DASHBOARD ══"
show_mtf   = input.bool(true,  "Show MTF Futures Table (15m, 1H, 1D)",  group=grp_vis, tooltip="Shows MTF status table for selected Futures stock")
mtf_pos    = input.string("Top Right", "MTF Table Position",
             options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=grp_vis)
show_scan  = input.bool(true,  "Show 36 Multi-Futures Scanner Table",    group=grp_vis, tooltip="Shows automatic scanner table for top 36 NSE Stock Futures")
scan_pos   = input.string("Bottom Right", "Multi-Futures Scanner Position",
             options=["Bottom Right","Top Right","Top Left","Bottom Left"], group=grp_vis)
scan_tf_in = input.string("Chart TF (Auto Sync)", "Scanner Timeframe",
             options=["Chart TF (Auto Sync)", "15m - Intraday", "1H - Hourly", "1D - Daily"], group=grp_vis)
show_colors= input.bool(true,  "Highlight Mother & Baby Candles",        group=grp_vis)
color_mb_m = input.color(color.new(color.aqua, 0),   "Mother Candle Highlight Color", group=grp_vis)
color_mb_b = input.color(color.new(color.yellow, 0), "Baby Candle Highlight Color",   group=grp_vis)

grp_al     = "══ ALERTS ══"
al_buy     = input.bool(true, "Alert BUY Breakout",  group=grp_al)
al_sell    = input.bool(true, "Alert SELL Breakout", group=grp_al)
al_sl      = input.bool(true, "Alert SL Hit",        group=grp_al)
al_tp1     = input.bool(true, "Alert TP1 Hit",       group=grp_al)

// Timeframe resolution helper
scan_tf = scan_tf_in == "Chart TF (Auto Sync)" ? timeframe.period : scan_tf_in == "15m - Intraday" ? "15" : scan_tf_in == "1H - Hourly" ? "60" : "D"

// ══════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════
_fmt(v)           => str.tostring(v, "#.##")
_dir_col(d)       => str.contains(d, "CLOSED (TP)") ? color.new(color.lime, 30) : str.contains(d, "CLOSED (SL)") ? color.new(color.red, 30) : d == "BULL BO" ? color.lime : d == "BEAR BO" ? color.red : d == "INSIDE" ? color.yellow : color.gray
_trend_str(u, dn) => u ? "BULL" : dn ? "BEAR" : "NEUT"
_trend_col(u, dn) => u ? color.lime : dn ? color.red : color.gray

// ══════════════════════════════════════════════════════════
// CORE MOTHER & BABY FUTURES ENGINE
// ══════════════════════════════════════════════════════════
f_mb_engine(_req_opp, _f_doji, _m_body_pct, _sl_src, _slm, _rr1, _rr2, _rr3,
             _f_ema, _f_rsi, _f_vol, _vmult, _f_wicks) =>
    _atr  = ta.atr(14)
    _e1   = ta.ema(close, 21)
    _e2   = ta.ema(close, 50)
    _rsi  = ta.rsi(close, 14)
    _vm   = ta.sma(volume, 20)

    _ema_bull = _e1 > _e2
    _ema_bear = _e1 < _e2
    _rsi_bull = _rsi > 50
    _rsi_bear = _rsi < 50
    _vol_ok   = volume > _vm * _vmult

    // 1. Strict Mother & Baby Inside Bar Detection
    _m_range = high[1] - low[1]
    _m_body  = math.abs(close[1] - open[1])
    _m_body_ratio = _m_range > 0 ? (_m_body / _m_range) * 100 : 0.0

    // Doji Filter: Mother candle body must be >= min_m_body %
    _is_mother_valid = not _f_doji or (_m_body_ratio >= _m_body_pct)

    // Strict Containment: Baby high <= Mother high AND Baby low >= Mother low
    _is_baby_inside  = (high <= high[1]) and (low >= low[1])

    // High Confidence Setup: Opposite Colors
    _is_mother_red   = close[1] < open[1]
    _is_mother_green = close[1] > open[1]
    _is_baby_red     = close < open
    _is_baby_green   = close > open

    _is_opp_color    = (_is_mother_red and _is_baby_green) or (_is_mother_green and _is_baby_red)
    _color_valid     = not _req_opp or _is_opp_color

    // Valid Pattern Trigger
    _is_mb_pattern   = _is_mother_valid and _is_baby_inside and _color_valid

    // Track active Mother Bar Boundaries
    var float _m_high = na
    var float _m_low  = na
    var bool  _in_ib  = false
    var bool  _is_opp_setup = false

    // Session / New Day Reset: Invalidate yesterday's inside bars on gap open / new day
    _is_new_day = timeframe.isintraday and (ta.change(time("D")) != 0)

    var bool _tr_act = false
    var int  _tr_dir = 0
    var string _st   = "NEUTRAL"
    var float  _en   = na
    var float  _sl   = na
    var float  _t1   = na
    var float  _t2   = na
    var float  _t3   = na

    if _is_new_day
        _in_ib := false
        _m_high := na
        _m_low  := na
        if _tr_act or _tr_dir != 0
            _tr_act := false
            _tr_dir := 0
            _st := "CLOSED (PREV DAY)"
        else if _st == "BULL BO" or _st == "BEAR BO" or str.contains(_st, "CLOSED")
            _st := "CLOSED (PREV DAY)"

    if _is_mb_pattern and not _in_ib and not _is_new_day
        _m_high := high[1]
        _m_low  := low[1]
        _in_ib  := true
        _is_opp_setup := _is_opp_color
    else if _in_ib and (high <= _m_high) and (low >= _m_low) and not _is_new_day
        _in_ib := true
    else
        if not _is_mb_pattern and not na(_m_high) and (close > _m_high or close < _m_low or high > _m_high or low < _m_low or _is_new_day)
            _in_ib := false

    // Breakout Rules with Wick Rejection Filter
    float _bo_rng = high - low
    bool _valid_buy_wick = not _f_wicks or (_bo_rng > 0 and ((close - low) / _bo_rng) >= 0.5)
    bool _valid_sel_wick = not _f_wicks or (_bo_rng > 0 and ((high - close) / _bo_rng) >= 0.5)

    _raw_buy  = _in_ib[1] and not _is_new_day and (close > _m_high) and (close > open) and _valid_buy_wick
    _raw_sell = _in_ib[1] and not _is_new_day and (close < _m_low)  and (close < open)  and _valid_sel_wick

    _buy_bo  = _raw_buy and not _tr_act and (_f_ema ? _ema_bull : true) and (_f_rsi ? _rsi_bull : true) and (_f_vol ? _vol_ok : true)
    _sell_bo = _raw_sell and not _tr_act and (_f_ema ? _ema_bear : true) and (_f_rsi ? _rsi_bear : true) and (_f_vol ? _vol_ok : true)

    // Calculate Entry, Stop Loss & Targets
    _sl_dist_b = _sl_src == "Breakout Candle Low/High" ? math.max(close - low, _atr * 0.5) :
                 _sl_src == "ATR Multiplier" ? _slm * _atr :
                 math.max(close - _m_low[1], _atr * 0.5)

    _sl_dist_s = _sl_src == "Breakout Candle Low/High" ? math.max(high - close, _atr * 0.5) :
                 _sl_src == "ATR Multiplier" ? _slm * _atr :
                 math.max(_m_high[1] - close, _atr * 0.5)

    if _buy_bo
        _st     := "BULL BO"
        _en     := close
        _sl     := close - _sl_dist_b
        _t1     := close + _rr1 * _sl_dist_b
        _t2     := close + _rr2 * _sl_dist_b
        _t3     := close + _rr3 * _sl_dist_b
        _tr_act := true
        _tr_dir := 1
        _in_ib  := false
    else if _sell_bo
        _st     := "BEAR BO"
        _en     := close
        _sl     := close + _sl_dist_s
        _t1     := close - _rr1 * _sl_dist_s
        _t2     := close - _rr2 * _sl_dist_s
        _t3     := close - _rr3 * _sl_dist_s
        _tr_act := true
        _tr_dir := -1
        _in_ib  := false

    // Monitor active trade for TP / SL completion
    if _tr_act and not _buy_bo and not _sell_bo
        if _tr_dir == 1
            if high >= _t1
                _st     := "CLOSED (TP)"
                _tr_act := false
                _tr_dir := 0
            else if low <= _sl
                _st     := "CLOSED (SL)"
                _tr_act := false
                _tr_dir := 0
            else if not _ema_bull
                _st     := "CLOSED (TREND FLIP)"
                _tr_act := false
                _tr_dir := 0
        else if _tr_dir == -1
            if low <= _t1
                _st     := "CLOSED (TP)"
                _tr_act := false
                _tr_dir := 0
            else if high >= _sl
                _st     := "CLOSED (SL)"
                _tr_act := false
                _tr_dir := 0
            else if not _ema_bear
                _st     := "CLOSED (TREND FLIP)"
                _tr_act := false
                _tr_dir := 0

    if _is_mb_pattern and not _buy_bo and not _sell_bo and not _tr_act
        _st := "INSIDE"

    [_is_mb_pattern, _buy_bo, _sell_bo, _st, _en, _sl, _t1, _t2, _t3, _is_opp_setup, _ema_bull]

f_mb_light(_req_opp, _f_doji, _m_body_pct, _f_ema, _f_wicks) =>
    [mb, b, s, st, en, sl, t1, t2, t3, opp, up] = f_mb_engine(_req_opp, _f_doji, _m_body_pct, "Mother Bar Boundary", 1.5, 1.5, 2.5, 4.0, _f_ema, false, false, 1.2, _f_wicks)
    [b, s, mb, opp, up, st == "BULL BO" or st == "BEAR BO" ? 1 : 0]

// ══════════════════════════════════════════════════════════
// FUTURES SYMBOL AUTO-SYNC (NSE:ROOT1!)
// ══════════════════════════════════════════════════════════
_fut_ticker = syminfo.prefix + ":" + syminfo.root + "1!"

// ══════════════════════════════════════════════════════════
// MULTI-TIMEFRAME ANALYSIS FOR FUTURES CONTRACT (15m, 1H, 1D) -> 3 Security Calls
// ══════════════════════════════════════════════════════════
[mb15, b15, s15, st15, en15, sl15, t1_15, t2_15, t3_15, opp15, up15] = request.security(
    _fut_ticker, "15", f_mb_engine(req_opp_col, filter_doji, min_m_body, sl_source, sl_mult, rr1, rr2, rr3, filter_ema, filter_rsi, filter_vol, vol_mult, filter_wicks), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

[mb1h, b1h, s1h, st1h, en1h, sl1h, t1_1h, t2_1h, t3_1h, opp1h, up1h] = request.security(
    _fut_ticker, "60", f_mb_engine(req_opp_col, filter_doji, min_m_body, sl_source, sl_mult, rr1, rr2, rr3, filter_ema, filter_rsi, filter_vol, vol_mult, filter_wicks), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

[mb1d, b1d, s1d, st1d, en1d, sl1d, t1_1d, t2_1d, t3_1d, opp1d, up1d] = request.security(
    _fut_ticker, "D",  f_mb_engine(req_opp_col, filter_doji, min_m_body, sl_source, sl_mult, rr1, rr2, rr3, filter_ema, filter_rsi, filter_vol, vol_mult, filter_wicks), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

// Daily EMA trend for HTF alignment check -> 1 Security Call
[_d_ema_bull] = request.security(_fut_ticker, "D", [ta.ema(close, 21) > ta.ema(close, 50)], lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

// ══════════════════════════════════════════════════════════
// CURRENT CHART TIMEFRAME EXECUTION
// ══════════════════════════════════════════════════════════
_atr  = ta.atr(14)
_e1   = ta.ema(close, 21)
_e2   = ta.ema(close, 50)
_rsi  = ta.rsi(close, 14)
_vm   = ta.sma(volume, 20)

_ema_bull = _e1 > _e2
_ema_bear = _e1 < _e2
_rsi_bull = _rsi > 50
_rsi_bear = _rsi < 50
_vol_ok   = volume > _vm * vol_mult

_is_intraday = timeframe.in_seconds() <= 3600
_htf_bull    = filter_htf ? (_is_intraday ? _d_ema_bull : _ema_bull) : true
_htf_bear    = filter_htf ? (_is_intraday ? not _d_ema_bull : _ema_bear) : true

_m_range = high[1] - low[1]
_m_body  = math.abs(close[1] - open[1])
_m_body_ratio = _m_range > 0 ? (_m_body / _m_range) * 100 : 0.0
_is_mother_valid = not filter_doji or (_m_body_ratio >= min_m_body)
_is_baby_inside  = (high <= high[1]) and (low >= low[1])

_is_mother_red   = close[1] < open[1]
_is_mother_green = close[1] > open[1]
_is_baby_red     = close < open
_is_baby_green   = close > open

_is_opp_color  = (_is_mother_red and _is_baby_green) or (_is_mother_green and _is_baby_red)
_color_valid   = not req_opp_col or _is_opp_color
_is_mb_pattern = _is_mother_valid and _is_baby_inside and _color_valid

// Chart Candle Coloring for Mother & Baby
barcolor(show_colors and _is_mb_pattern ? color_mb_b : show_colors and _is_mb_pattern[1] ? color_mb_m : na)

// ══════════════════════════════════════════════════════════
// TRADE MANAGER (Zone Lines & Box Variables & Helper)
// ══════════════════════════════════════════════════════════
var float  _tent   = na
var float  _tsl    = na
var float  _ttp1   = na
var float  _ttp2   = na
var float  _ttp3   = na
var bool   _tp1hit = false
var bool   _tp2hit = false
var bool   _tp3hit = false
var bool   _slhit  = false

var line _zl_en = na
var line _zl_sl = na
var line _zl_t1 = na
var line _zl_t2 = na
var line _zl_t3 = na
var linefill _zf_sl = na
var linefill _zf_t1 = na
var linefill _zf_t2 = na
var linefill _zf_t3 = na
var label _lb_en = na
var label _lb_sl = na
var label _lb_t1 = na
var label _lb_t2 = na
var label _lb_t3 = na

_del_zones() =>
    line.delete(_zl_en)
    line.delete(_zl_sl)
    line.delete(_zl_t1)
    line.delete(_zl_t2)
    line.delete(_zl_t3)
    linefill.delete(_zf_sl)
    linefill.delete(_zf_t1)
    linefill.delete(_zf_t2)
    linefill.delete(_zf_t3)
    label.delete(_lb_en)
    label.delete(_lb_sl)
    label.delete(_lb_t1)
    label.delete(_lb_t2)
    label.delete(_lb_t3)

var float  _m_high = na
var float  _m_low  = na
var bool   _in_ib  = false
var bool   _is_opp_setup = false
var string _tdir   = "NONE"

_is_chart_new_day = timeframe.isintraday and (ta.change(time("D")) != 0)

if _is_chart_new_day
    _in_ib := false
    _m_high := na
    _m_low  := na
    if _tdir != "NONE"
        _del_zones()
        _tdir := "NONE"

if _is_mb_pattern and not _in_ib and (_tdir == "NONE") and not _is_chart_new_day
    _m_high := high[1]
    _m_low  := low[1]
    _in_ib  := true
    _is_opp_setup := _is_opp_color
else if _in_ib and (high <= _m_high) and (low >= _m_low) and not _is_chart_new_day
    _in_ib := true
else
    if not _is_mb_pattern and not na(_m_high) and (close > _m_high or close < _m_low or high > _m_high or low < _m_low or _is_chart_new_day)
        _in_ib := false

// Breakout Candle Wick Rejection Filter
float _bo_rng = high - low
bool _valid_buy_wick = not filter_wicks or (_bo_rng > 0 and ((close - low) / _bo_rng) >= 0.5)
bool _valid_sel_wick = not filter_wicks or (_bo_rng > 0 and ((high - close) / _bo_rng) >= 0.5)

_raw_buy  = _in_ib[1] and not _is_chart_new_day and (close > _m_high) and (close > open) and _valid_buy_wick
_raw_sell = _in_ib[1] and not _is_chart_new_day and (close < _m_low)  and (close < open)  and _valid_sel_wick

_buy_sig  = _raw_buy and (_tdir == "NONE") and (filter_ema ? _ema_bull : true) and (filter_rsi ? _rsi_bull : true) and (filter_vol ? _vol_ok : true) and _htf_bull
_sell_sig = _raw_sell and (_tdir == "NONE") and (filter_ema ? _ema_bear : true) and (filter_rsi ? _rsi_bear : true) and (filter_vol ? _vol_ok : true) and _htf_bear

var int _b_since_buy  = 999
var int _b_since_sell = 999

if _buy_sig
    _b_since_buy := 0
else
    _b_since_buy := _b_since_buy + 1

if _sell_sig
    _b_since_sell := 0
else
    _b_since_sell := _b_since_sell + 1

_is_fresh_buy  = _b_since_buy <= 5
_is_fresh_sell = _b_since_sell <= 5

// Dynamic Signal Tracking (Active vs Closed Signals)
var label[] _lbl_arr = array.new_label(0)
var float[] _sl_arr  = array.new_float(0)
var float[] _tp1_arr = array.new_float(0)
var int[]   _dir_arr = array.new_int(0)
var bool[]  _act_arr = array.new_bool(0)

if show_labels and _buy_sig
    _sl_dist = sl_source == "Breakout Candle Low/High" ? math.max(close - low, _atr * 0.5) :
               sl_source == "ATR Multiplier" ? sl_mult * _atr :
               math.max(close - _m_low[1], _atr * 0.5)
    _sl_val = close - _sl_dist
    _t1_val = close + rr1 * _sl_dist
    _t2_val = close + rr2 * _sl_dist
    _t3_val = close + rr3 * _sl_dist
    _conf_tag = _is_opp_setup ? " [HIGH CONFIDENCE 🔥]" : ""
    _tip_b = "📈 FUTURES BUY BREAKOUT (" + timeframe.period + ")" + _conf_tag + "\n" +
             "────────────────────────\n" +
             "Contract: " + syminfo.root + "1!\n" +
             "Entry Price: " + _fmt(close) + "\n" +
             "Stop Loss: "   + _fmt(_sl_val) + "\n" +
             "TP1 (1.5R): "  + _fmt(_t1_val) + "\n" +
             "TP2 (2.5R): "  + _fmt(_t2_val) + "\n" +
             "TP3 (4.0R): "  + _fmt(_t3_val)
    _l = label.new(bar_index, low, "🔥 FUT BUY", style=label.style_label_up,
               color=color.lime, textcolor=color.black, size=size.normal,
               tooltip=_tip_b)
    array.push(_lbl_arr, _l)
    array.push(_sl_arr,  _sl_val)
    array.push(_tp1_arr, _t1_val)
    array.push(_dir_arr, 1)
    array.push(_act_arr, true)

if show_labels and _sell_sig
    _sl_dist = sl_source == "Breakout Candle Low/High" ? math.max(high - close, _atr * 0.5) :
               sl_source == "ATR Multiplier" ? sl_mult * _atr :
               math.max(_m_high[1] - close, _atr * 0.5)
    _sl_val = close + _sl_dist
    _t1_val = close - rr1 * _sl_dist
    _t2_val = close - rr2 * _sl_dist
    _t3_val = close - rr3 * _sl_dist
    _conf_tag = _is_opp_setup ? " [HIGH CONFIDENCE 🔥]" : ""
    _tip_s = "📉 FUTURES SELL BREAKDOWN (" + timeframe.period + ")" + _conf_tag + "\n" +
             "────────────────────────\n" +
             "Contract: " + syminfo.root + "1!\n" +
             "Entry Price: " + _fmt(close) + "\n" +
             "Stop Loss: "   + _fmt(_sl_val) + "\n" +
             "TP1 (1.5R): "  + _fmt(_t1_val) + "\n" +
             "TP2 (2.5R): "  + _fmt(_t2_val) + "\n" +
             "TP3 (4.0R): "  + _fmt(_t3_val)
    _l = label.new(bar_index, high, "🔥 FUT SELL", style=label.style_label_down,
               color=color.red, textcolor=color.white, size=size.normal,
               tooltip=_tip_s)
    array.push(_lbl_arr, _l)
    array.push(_sl_arr,  _sl_val)
    array.push(_tp1_arr, _t1_val)
    array.push(_dir_arr, -1)
    array.push(_act_arr, true)

// Update historical signal labels dynamically across bars
if array.size(_lbl_arr) > 0
    for i = 0 to array.size(_lbl_arr) - 1
        if array.get(_act_arr, i)
            _dir = array.get(_dir_arr, i)
            _tp  = array.get(_tp1_arr, i)
            _sl  = array.get(_sl_arr, i)
            _lbl = array.get(_lbl_arr, i)

            if _is_chart_new_day
                array.set(_act_arr, i, false)
                label.set_text(_lbl, "⏱️ " + (_dir == 1 ? "BUY" : "SELL") + " (CLOSED - PREV DAY)")
                label.set_color(_lbl, color.new(color.gray, 20))
                label.set_textcolor(_lbl, color.white)
                label.set_size(_lbl, size.small)
            else if _dir == 1
                if high >= _tp
                    array.set(_act_arr, i, false)
                    label.set_text(_lbl, "✅ BUY (CLOSED - TP)")
                    label.set_color(_lbl, color.new(#1b5e20, 20))
                    label.set_textcolor(_lbl, color.lime)
                    label.set_size(_lbl, size.small)
                else if low <= _sl
                    array.set(_act_arr, i, false)
                    label.set_text(_lbl, "❌ BUY (CLOSED - SL)")
                    label.set_color(_lbl, color.new(#b71c1c, 20))
                    label.set_textcolor(_lbl, color.white)
                    label.set_size(_lbl, size.small)
            else if _dir == -1
                if low <= _tp
                    array.set(_act_arr, i, false)
                    label.set_text(_lbl, "✅ SELL (CLOSED - TP)")
                    label.set_color(_lbl, color.new(#1b5e20, 20))
                    label.set_textcolor(_lbl, color.lime)
                    label.set_size(_lbl, size.small)
                else if high >= _sl
                    array.set(_act_arr, i, false)
                    label.set_text(_lbl, "❌ SELL (CLOSED - SL)")
                    label.set_color(_lbl, color.new(#b71c1c, 20))
                    label.set_textcolor(_lbl, color.white)
                    label.set_size(_lbl, size.small)

// ══════════════════════════════════════════════════════════
// TRADE MANAGER Execution
// ══════════════════════════════════════════════════════════
if _buy_sig
    _tdir   := "LONG"
    _tent   := close
    _sl_d    = sl_source == "Breakout Candle Low/High" ? math.max(close - low, _atr * 0.5) :
               sl_source == "ATR Multiplier" ? sl_mult * _atr :
               math.max(close - _m_low[1], _atr * 0.5)
    _tsl    := close - _sl_d
    _ttp1   := close + rr1 * _sl_d
    _ttp2   := close + rr2 * _sl_d
    _ttp3   := close + rr3 * _sl_d
    _tp1hit := false
    _tp2hit := false
    _tp3hit := false
    _slhit  := false
    if show_zones
        _del_zones()
        _x2 = bar_index + zone_ext
        _lx = _x2 + 1
        _zl_en := line.new(bar_index, close, _x2, close, color=color.white, width=2)
        _zl_sl := line.new(bar_index, _tsl,  _x2, _tsl,  color=color.red,   width=2)
        _zl_t1 := line.new(bar_index, _ttp1, _x2, _ttp1, color=color.new(color.yellow, 20), width=1)
        _zl_t2 := line.new(bar_index, _ttp2, _x2, _ttp2, color=color.new(color.lime,   20), width=2)
        _zl_t3 := line.new(bar_index, _ttp3, _x2, _ttp3, color=color.new(color.teal,   20), width=2)
        _zf_sl := linefill.new(_zl_sl, _zl_en, color.new(color.red,   96))
        _zf_t1 := linefill.new(_zl_en, _zl_t1, color.new(color.lime,  97))
        _zf_t2 := linefill.new(_zl_t1, _zl_t2, color.new(color.green, 96))
        _zf_t3 := linefill.new(_zl_t2, _zl_t3, color.new(color.teal,  96))
        _lb_en := label.new(_lx, close, "ENTRY " + _fmt(close), style=label.style_label_left, color=color.new(color.gray, 20), textcolor=color.white, size=size.small)
        _lb_sl := label.new(_lx, _tsl,  "SL "    + _fmt(_tsl),  style=label.style_label_left, color=color.new(color.red,  20), textcolor=color.white, size=size.small)
        _lb_t1 := label.new(_lx, _ttp1, "TP1 "   + _fmt(_ttp1), style=label.style_label_left, color=color.new(color.yellow,20), textcolor=color.white, size=size.small)
        _lb_t2 := label.new(_lx, _ttp2, "TP2 "   + _fmt(_ttp2), style=label.style_label_left, color=color.new(color.lime, 20), textcolor=color.white, size=size.small)
        _lb_t3 := label.new(_lx, _ttp3, "TP3 "   + _fmt(_ttp3), style=label.style_label_left, color=color.new(color.teal, 20), textcolor=color.white, size=size.small)

if _sell_sig
    _tdir   := "SHORT"
    _tent   := close
    _sl_d    = sl_source == "Breakout Candle Low/High" ? math.max(high - close, _atr * 0.5) :
               sl_source == "ATR Multiplier" ? sl_mult * _atr :
               math.max(_m_high[1] - close, _atr * 0.5)
    _tsl    := close + _sl_d
    _ttp1   := close - rr1 * _sl_d
    _ttp2   := close - rr2 * _sl_d
    _ttp3   := close - rr3 * _sl_d
    _tp1hit := false
    _tp2hit := false
    _tp3hit := false
    _slhit  := false
    if show_zones
        _del_zones()
        _x2 = bar_index + zone_ext
        _lx = _x2 + 1
        _zl_en := line.new(bar_index, close, _x2, close, color=color.white, width=2)
        _zl_sl := line.new(bar_index, _tsl,  _x2, _tsl,  color=color.red,   width=2)
        _zl_t1 := line.new(bar_index, _ttp1, _x2, _ttp1, color=color.new(color.yellow, 20), width=1)
        _zl_t2 := line.new(bar_index, _ttp2, _x2, _ttp2, color=color.new(color.lime,   20), width=2)
        _zl_t3 := line.new(bar_index, _ttp3, _x2, _ttp3, color=color.new(color.teal,   20), width=2)
        _zf_sl := linefill.new(_zl_en, _zl_sl, color.new(color.red,   96))
        _zf_t1 := linefill.new(_zl_t1, _zl_en, color.new(color.lime,  97))
        _zf_t2 := linefill.new(_zl_t2, _zl_t1, color.new(color.green, 96))
        _zf_t3 := linefill.new(_zl_t3, _zl_t2, color.new(color.teal,  96))
        _lb_en := label.new(_lx, close, "ENTRY " + _fmt(close), style=label.style_label_left, color=color.new(color.gray, 20), textcolor=color.white, size=size.small)
        _lb_sl := label.new(_lx, _tsl,  "SL "    + _fmt(_tsl),  style=label.style_label_left, color=color.new(color.red,  20), textcolor=color.white, size=size.small)
        _lb_t1 := label.new(_lx, _ttp1, "TP1 "   + _fmt(_ttp1), style=label.style_label_left, color=color.new(color.yellow,20), textcolor=color.white, size=size.small)
        _lb_t2 := label.new(_lx, _ttp2, "TP2 "   + _fmt(_ttp2), style=label.style_label_left, color=color.new(color.lime, 20), textcolor=color.white, size=size.small)
        _lb_t3 := label.new(_lx, _ttp3, "TP3 "   + _fmt(_ttp3), style=label.style_label_left, color=color.new(color.teal, 20), textcolor=color.white, size=size.small)

if _tdir != "NONE"
    if show_zones and not na(_zl_en) and barstate.islast
        _nx = bar_index + zone_ext
        line.set_x2(_zl_en, _nx)
        line.set_x2(_zl_sl, _nx)
        line.set_x2(_zl_t1, _nx)
        line.set_x2(_zl_t2, _nx)
        line.set_x2(_zl_t3, _nx)
        if not na(_lb_en)
            label.set_x(_lb_en, _nx + 1)
            label.set_x(_lb_sl, _nx + 1)
            label.set_x(_lb_t1, _nx + 1)
            label.set_x(_lb_t2, _nx + 1)
            label.set_x(_lb_t3, _nx + 1)
    if _tdir == "LONG"
        if not _tp1hit and high >= _ttp1
            _tp1hit := true
        if not _tp2hit and high >= _ttp2
            _tp2hit := true
        if not _tp3hit and high >= _ttp3
            _tp3hit := true
        if not _slhit and low <= _tsl
            _slhit := true
        if _ema_bear or low <= _tsl or high >= _ttp1
            _del_zones()
            _tdir := "NONE"

    if _tdir == "SHORT"
        if not _tp1hit and low <= _ttp1
            _tp1hit := true
        if not _tp2hit and low <= _ttp2
            _tp2hit := true
        if not _tp3hit and low <= _ttp3
            _tp3hit := true
        if not _slhit and high >= _tsl
            _slhit := true
        if _ema_bull or high >= _tsl or low <= _ttp1
            _del_zones()
            _tdir := "NONE"

// ══════════════════════════════════════════════════════════
// MTF FUTURES TABLE (15m, 1H, 1D)
// ══════════════════════════════════════════════════════════
_mtf_tbl_pos = mtf_pos == "Top Right" ? position.top_right : mtf_pos == "Top Left" ? position.top_left : mtf_pos == "Bottom Right" ? position.bottom_right : position.bottom_left

var table _tb = table.new(_mtf_tbl_pos, 4, 10,
    bgcolor=color.new(color.black, 75),
    border_color=color.new(color.gray, 50), border_width=1,
    frame_color=color.new(#7c4dff, 30), frame_width=1)

_row(r, lbl, v15, v1h, v1d, c15, c1h, c1d) =>
    table.cell(_tb, 0, r, lbl, text_color=color.gray, text_size=size.small, bgcolor=color.new(color.black, 80))
    table.cell(_tb, 1, r, v15, text_color=c15,        text_size=size.small, bgcolor=color.new(color.black, 80), text_halign=text.align_right)
    table.cell(_tb, 2, r, v1h, text_color=c1h,        text_size=size.small, bgcolor=color.new(color.black, 80), text_halign=text.align_right)
    table.cell(_tb, 3, r, v1d, text_color=c1d,        text_size=size.small, bgcolor=color.new(color.black, 80), text_halign=text.align_right)

_is_act(st) => st == "BULL BO" or st == "BEAR BO"

if barstate.islast and show_mtf
    _cur_newsig = _buy_sig ? "🔥 BUY (LIVE)" : _is_fresh_buy ? "🔥 BUY (" + str.tostring(_b_since_buy) + "b)" : _sell_sig ? "🔥 SELL (LIVE)" : _is_fresh_sell ? "🔥 SELL (" + str.tostring(_b_since_sell) + "b)" : "-"
    _cur_sigcol = (_buy_sig or _is_fresh_buy) ? color.lime : (_sell_sig or _is_fresh_sell) ? color.red : color.gray

    _hdr_txt = "⚡ FUT: " + syminfo.root + "1!"
    table.cell(_tb, 0, 0, _hdr_txt, text_color=color.white, text_size=size.small, bgcolor=color.new(#7c4dff, 20), text_halign=text.align_center)
    table.cell(_tb, 1, 0, "15m",     text_color=color.aqua,  text_size=size.small, bgcolor=color.new(#7c4dff, 40), text_halign=text.align_center)
    table.cell(_tb, 2, 0, "1H",      text_color=color.purple,text_size=size.small, bgcolor=color.new(#7c4dff, 40), text_halign=text.align_center)
    table.cell(_tb, 3, 0, "1D",      text_color=color.orange,text_size=size.small, bgcolor=color.new(#7c4dff, 40), text_halign=text.align_center)

    _row(1, "TREND",
        _trend_str(up15, not up15), _trend_str(up1h, not up1h), _trend_str(up1d, not up1d),
        _trend_col(up15, not up15), _trend_col(up1h, not up1h), _trend_col(up1d, not up1d))

    _row(2, "STATUS",
        st15, st1h, st1d,
        _dir_col(st15), _dir_col(st1h), _dir_col(st1d))

    _row(3, "OPP COLOR",
        opp15 ? "YES 🔥" : "NO", opp1h ? "YES 🔥" : "NO", opp1d ? "YES 🔥" : "NO",
        opp15 ? color.lime : color.gray, opp1h ? color.lime : color.gray, opp1d ? color.lime : color.gray)

    _row(4, "ENTRY",
        _is_act(st15) ? _fmt(en15) : "---", _is_act(st1h) ? _fmt(en1h) : "---", _is_act(st1d) ? _fmt(en1d) : "---",
        color.white, color.white, color.white)

    _row(5, "SL",
        _is_act(st15) ? _fmt(sl15) : "---", _is_act(st1h) ? _fmt(sl1h) : "---", _is_act(st1d) ? _fmt(sl1d) : "---",
        color.red, color.red, color.red)

    _row(6, "TP1",
        _is_act(st15) ? _fmt(t1_15) : "---", _is_act(st1h) ? _fmt(t1_1h) : "---", _is_act(st1d) ? _fmt(t1_1d) : "---",
        color.yellow, color.yellow, color.yellow)

    _row(7, "TP2",
        _is_act(st15) ? _fmt(t2_15) : "---", _is_act(st1h) ? _fmt(t2_1h) : "---", _is_act(st1d) ? _fmt(t2_1d) : "---",
        color.lime, color.lime, color.lime)

    _row(8, "TP3",
        _is_act(st15) ? _fmt(t3_15) : "---", _is_act(st1h) ? _fmt(t3_1h) : "---", _is_act(st1d) ? _fmt(t3_1d) : "---",
        color.teal, color.teal, color.teal)

    _row(9, "FRESH SIG",
        _cur_newsig, b1h ? "BUY" : s1h ? "SELL" : "-", b1d ? "BUY" : s1d ? "SELL" : "-",
        _cur_sigcol, b1h ? color.lime : s1h ? color.red : color.gray, b1d ? color.lime : s1d ? color.red : color.gray)

// ══════════════════════════════════════════════════════════
// 36 MULTI-STOCK FUTURES SCANNER CALLS (Exactly 36 Security Calls)
// ══════════════════════════════════════════════════════════
[fb01,fs01,fp01,fo01,fe01,fa01] = request.security("NSE:RELIANCE1!",   scan_tf, f_mb_light(req_opp_col,filter_doji,min_m_body,filter_ema,filter_wicks), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
