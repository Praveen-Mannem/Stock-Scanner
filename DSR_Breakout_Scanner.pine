// ============================================================
// DSR BREAKOUT SCANNER — Daily & Weekly
// ============================================================
// HOW TO USE AS A MULTI-STOCK SCANNER:
//   1. Add this indicator to any chart
//   2. Open TradingView → Screener → Stock Screener
//   3. Click "Filters" → Add Filter → Technical → Custom Script Filter
//   4. Select this script and choose "Daily Breakout" or "Weekly Breakout"
//   5. The screener will list ALL stocks matching the condition
//
//   ALTERNATIVE (Alerts method):
//   - Set alerts on "DSR Daily BO" and "DSR Weekly BO" for your watchlist
// ============================================================
//@version=6
indicator("DSR Breakout Scanner", shorttitle="DSR BO SCAN", overlay=true,
          max_bars_back=500, max_lines_count=50, max_labels_count=50)

// ══════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════
grp_d   = "══ DAILY BREAKOUT ══"
d_hh_len  = input.int(20,   "Daily: Lookback Bars for High",        group=grp_d, minval=5, maxval=100)
d_vol_en  = input.bool(true, "Daily: Volume Confirmation",           group=grp_d)
d_vol_m   = input.float(1.3, "Daily: Volume Multiplier",             group=grp_d, minval=1.0, step=0.1)
d_adx_en  = input.bool(true, "Daily: ADX Filter (≥20)",              group=grp_d)
d_body_en = input.bool(true, "Daily: Strong Candle Body (≥40%)",     group=grp_d)
d_ema_en  = input.bool(true, "Daily: EMA Trend Filter (9>21>50)",    group=grp_d)

grp_w   = "══ WEEKLY BREAKOUT ══"
w_hh_len  = input.int(10,   "Weekly: Lookback Bars for High",        group=grp_w, minval=3, maxval=52)
w_vol_en  = input.bool(true, "Weekly: Volume Confirmation",           group=grp_w)
w_vol_m   = input.float(1.2, "Weekly: Volume Multiplier",             group=grp_w, minval=1.0, step=0.1)
w_adx_en  = input.bool(false,"Weekly: ADX Filter (≥20)",              group=grp_w)
w_ema_en  = input.bool(true, "Weekly: EMA Trend Filter (9>21>50)",    group=grp_w)

grp_vis = "══ VISUALS ══"
show_d_line = input.bool(true,  "Show Daily Resistance Line",         group=grp_vis)
show_w_line = input.bool(true,  "Show Weekly Resistance Line",        group=grp_vis)
show_table  = input.bool(true,  "Show Status Table",                  group=grp_vis)
tbl_pos     = input.string("Top Right", "Table Position",
              options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=grp_vis)

// ══════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════
_fmt(v)  => str.tostring(math.round(v * 100) / 100)
_pct(v, ref) => str.tostring(math.round((v / ref - 1) * 1000) / 10) + "%"

// ══════════════════════════════════════════════════════════
// DAILY BREAKOUT LOGIC  (via request.security)
// ══════════════════════════════════════════════════════════
f_daily(hh_len, vol_mult, adx_en, vol_en, body_en, ema_en) =>
    _h   = ta.highest(high[1], hh_len)          // prior N-bar high (no lookahead)
    _atr = ta.atr(14)
    _e1  = ta.ema(close, 9)
    _e2  = ta.ema(close, 21)
    _e3  = ta.ema(close, 50)
    _vm  = ta.sma(volume, 20)
    [_dp, _dm, _adxv] = ta.dmi(14, 14)
    _body = (high - low) > 0 ? math.abs(close - open) / (high - low) : 0.0
    _bull_candle = close > open                  // green candle
    _ema_bull    = (_e1 > _e2) and (_e2 > _e3)
    _vol_ok      = volume > _vm * vol_mult
    _adx_ok      = _adxv >= 20
    _body_ok     = _body >= 0.40
    // Breakout: close crosses above the prior high with buffer
    _bo = (close > _h) and (close[1] <= _h[1]) and _bull_candle
    // Apply optional filters
    _bo_f = _bo and
          (ema_en  ? _ema_bull : true) and
          (vol_en  ? _vol_ok   : true) and
          (adx_en  ? _adx_ok   : true) and
          (body_en ? _body_ok  : true)
    [_bo_f, _h, _adxv, _ema_bull, _vol_ok, _e1, _e2, _e3]

// ── Request daily data ─────────────────────────────────────
[d_bo, d_res, d_adx, d_ema, d_vol, d_e1, d_e2, d_e3] = request.security(
    syminfo.tickerid, "D",
    f_daily(d_hh_len, d_vol_m, d_adx_en, d_vol_en, d_body_en, d_ema_en),
    lookahead=barmerge.lookahead_off)

// ══════════════════════════════════════════════════════════
// WEEKLY BREAKOUT LOGIC  (via request.security)
// ══════════════════════════════════════════════════════════
f_weekly(hh_len, vol_mult, adx_en, vol_en, ema_en) =>
    _h   = ta.highest(high[1], hh_len)
    _e1  = ta.ema(close, 9)
    _e2  = ta.ema(close, 21)
    _e3  = ta.ema(close, 50)
    _vm  = ta.sma(volume, 20)
    [_dp, _dm, _adxv] = ta.dmi(14, 14)
    _bull_candle = close > open
    _ema_bull    = (_e1 > _e2) and (_e2 > _e3)
    _vol_ok      = volume > _vm * vol_mult
    _adx_ok      = _adxv >= 20
    _bo = (close > _h) and (close[1] <= _h[1]) and _bull_candle
    _bo_f = _bo and
          (ema_en ? _ema_bull : true) and
          (vol_en ? _vol_ok   : true) and
          (adx_en ? _adx_ok   : true)
    [_bo_f, _h, _adxv, _ema_bull, _vol_ok, _e1, _e2, _e3]

// ── Request weekly data ────────────────────────────────────
[w_bo, w_res, w_adx, w_ema, w_vol, w_e1, w_e2, w_e3] = request.security(
    syminfo.tickerid, "W",
    f_weekly(w_hh_len, w_vol_m, w_adx_en, w_vol_en, w_ema_en),
    lookahead=barmerge.lookahead_off)

// ══════════════════════════════════════════════════════════
// CURRENT CHART TF — nearby context
// ══════════════════════════════════════════════════════════
_atr_cur  = ta.atr(14)
_e1_cur   = ta.ema(close, 9)
_e2_cur   = ta.ema(close, 21)
_e3_cur   = ta.ema(close, 50)
_e4_cur   = ta.ema(close, 200)

// ── EMA plots ────────────────────────────────────────────
plot(_e1_cur, "EMA9",   color=color.new(color.yellow, 30), linewidth=1)
plot(_e2_cur, "EMA21",  color=color.new(color.orange, 30), linewidth=1)
plot(_e3_cur, "EMA50",  color=color.new(color.red,    30), linewidth=2)
plot(_e4_cur, "EMA200", color=color.new(color.purple, 30), linewidth=2)

// ══════════════════════════════════════════════════════════
// RESISTANCE LEVEL LINES
// ══════════════════════════════════════════════════════════
// Daily resistance — plotted as a step line
plot(show_d_line ? d_res : na, "Daily Resistance",
     color=color.new(color.orange, 20), linewidth=2, style=plot.style_stepline)

// Weekly resistance — plotted as a step line
plot(show_w_line ? w_res : na, "Weekly Resistance",
     color=color.new(color.yellow, 10), linewidth=3, style=plot.style_stepline)

// ══════════════════════════════════════════════════════════
// BREAKOUT SIGNALS — Arrows on chart
// ══════════════════════════════════════════════════════════
// Daily breakout arrow (orange)
plotshape(d_bo, "Daily BO",
          shape.triangleup, location.belowbar,
          color.new(color.orange, 0),
          textcolor=color.black, text="D-BO",
          size=size.normal)

// Weekly breakout arrow (yellow/gold — bigger)
plotshape(w_bo, "Weekly BO",
          shape.triangleup, location.belowbar,
          color.new(color.yellow, 0),
          textcolor=color.black, text="W-BO",
          size=size.large)

// Both breakouts simultaneously (rare, strong signal)
_both_bo = d_bo and w_bo
plotshape(_both_bo, "Daily+Weekly BO",
          shape.star, location.belowbar,
          color.new(color.fuchsia, 0),
          textcolor=color.white, text="D+W BO!",
          size=size.huge)

// ── Candle highlight on breakout ────────────────────────
bgcolor(d_bo    ? color.new(color.orange, 88) : na)
bgcolor(w_bo    ? color.new(color.yellow, 82) : na)
bgcolor(_both_bo? color.new(color.fuchsia,78) : na)

// ══════════════════════════════════════════════════════════
// STATUS TABLE  (bottom-right, updates live)
// ══════════════════════════════════════════════════════════
_d_status  = d_bo ? "🔥 BREAKOUT" : close > d_res ? "▲ ABOVE RES" : "— BELOW RES"
_w_status  = w_bo ? "🔥 BREAKOUT" : close > w_res ? "▲ ABOVE RES" : "— BELOW RES"
_d_scol    = d_bo ? color.orange   : close > d_res ? color.lime     : color.gray
_w_scol    = w_bo ? color.yellow   : close > w_res ? color.lime     : color.gray
_d_pct_str = not na(d_res) ? _pct(close, d_res) : "---"
_w_pct_str = not na(w_res) ? _pct(close, w_res) : "---"
_d_adx_col = d_adx >= 20 ? color.lime : color.orange
_w_adx_col = w_adx >= 20 ? color.lime : color.orange
_d_ema_col = d_ema ? color.lime : color.red
_w_ema_col = w_ema ? color.lime : color.red
_d_vol_col = d_vol ? color.lime : color.orange
_w_vol_col = w_vol ? color.lime : color.orange

_tp = tbl_pos == "Top Right" ? position.top_right : tbl_pos == "Top Left" ? position.top_left : tbl_pos == "Bottom Right" ? position.bottom_right : position.bottom_left

var table _t = table.new(_tp, 3, 10,
    bgcolor=color.new(color.black, 72),
    border_color=color.new(color.gray, 50), border_width=1,
    frame_color=color.new(color.gray,  30), frame_width=1)

_tc(col, row, txt, tc, bg) =>
    table.cell(_t, col, row, txt,
               text_color=tc, text_size=size.small,
               bgcolor=bg, text_halign=text.align_center)

if barstate.islast and show_table
    // Header
    _tc(0, 0, "DSR BO SCAN",      color.white,              color.new(color.navy,  10))
    _tc(1, 0, "DAILY",            color.new(color.orange,0), color.new(color.navy, 30))
    _tc(2, 0, "WEEKLY",           color.new(color.yellow,0), color.new(color.navy, 30))

    // Symbol row
    _tc(0, 1, "SYMBOL",           color.gray,               color.new(color.black, 80))
    _tc(1, 1, syminfo.ticker,     color.white,              color.new(color.black, 80))
    _tc(2, 1, syminfo.ticker,     color.white,              color.new(color.black, 80))

    // Status
    _tc(0, 2, "STATUS",           color.gray,               color.new(color.black, 80))
    _tc(1, 2, _d_status,          _d_scol,                  color.new(color.black, 75))
    _tc(2, 2, _w_status,          _w_scol,                  color.new(color.black, 75))

    // Resistance level
    _tc(0, 3, "RESISTANCE",       color.gray,               color.new(color.black, 80))
    _tc(1, 3, not na(d_res) ? _fmt(d_res) : "---", color.white, color.new(color.black, 80))
    _tc(2, 3, not na(w_res) ? _fmt(w_res) : "---", color.white, color.new(color.black, 80))

    // % vs resistance
    _tc(0, 4, "vs RES %",         color.gray,               color.new(color.black, 80))
    _tc(1, 4, _d_pct_str,         close > d_res ? color.lime : color.red, color.new(color.black, 80))
    _tc(2, 4, _w_pct_str,         close > w_res ? color.lime : color.red, color.new(color.black, 80))

    // ADX
    _tc(0, 5, "ADX",              color.gray,               color.new(color.black, 80))
    _tc(1, 5, str.tostring(math.round(d_adx)), _d_adx_col, color.new(color.black, 80))
    _tc(2, 5, str.tostring(math.round(w_adx)), _w_adx_col, color.new(color.black, 80))

    // EMA Trend
    _tc(0, 6, "EMA TREND",        color.gray,               color.new(color.black, 80))
    _tc(1, 6, d_ema ? "BULL ✓" : "BEAR ✗", _d_ema_col,    color.new(color.black, 80))
    _tc(2, 6, w_ema ? "BULL ✓" : "BEAR ✗", _w_ema_col,    color.new(color.black, 80))

    // Volume
    _tc(0, 7, "HIGH VOL",         color.gray,               color.new(color.black, 80))
    _tc(1, 7, d_vol ? "YES ✓" : "NO",  _d_vol_col,         color.new(color.black, 80))
    _tc(2, 7, w_vol ? "YES ✓" : "NO",  _w_vol_col,         color.new(color.black, 80))

    // Lookback
    _tc(0, 8, "LOOKBACK",         color.gray,               color.new(color.black, 80))
    _tc(1, 8, str.tostring(d_hh_len) + "D bars", color.silver, color.new(color.black, 80))
    _tc(2, 8, str.tostring(w_hh_len) + "W bars", color.silver, color.new(color.black, 80))

    // Today's signal
    _tc(0, 9, "TODAY",            color.gray,               color.new(color.black, 80))
    _tc(1, 9, d_bo ? "🔥 DAILY BO!" : "-", d_bo ? color.orange : color.gray, color.new(color.black, d_bo ? 70 : 80))
    _tc(2, 9, w_bo ? "🔥 WEEKLY BO!" : "-", w_bo ? color.yellow : color.gray, color.new(color.black, w_bo ? 70 : 80))

// ══════════════════════════════════════════════════════════
// ALERT CONDITIONS
// (Set these in TradingView Alerts → for each stock in watchlist)
// ══════════════════════════════════════════════════════════
alertcondition(d_bo,     "DSR Daily BO",       "DAILY BREAKOUT: {{ticker}} broke above {{d_hh_len}}-day high")
alertcondition(w_bo,     "DSR Weekly BO",      "WEEKLY BREAKOUT: {{ticker}} broke above {{w_hh_len}}-week high")
alertcondition(_both_bo, "DSR Daily+Weekly BO","STRONG BREAKOUT: {{ticker}} Daily + Weekly breakout!")

if d_bo
    alert("📈 DAILY BREAKOUT: " + syminfo.ticker +
          " | Close: " + _fmt(close) +
          " | Broke: " + _fmt(d_res) +
          " | ADX: " + str.tostring(math.round(d_adx)),
          alert.freq_once_per_bar)

if w_bo
    alert("🚀 WEEKLY BREAKOUT: " + syminfo.ticker +
          " | Close: " + _fmt(close) +
          " | Broke: " + _fmt(w_res) +
          " | ADX: " + str.tostring(math.round(w_adx)),
          alert.freq_once_per_bar)
// ══════════════════════════════════════════════════════════
// END DSR BREAKOUT SCANNER
// ══════════════════════════════════════════════════════════
