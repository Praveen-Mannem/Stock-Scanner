// ════════════════════════════════════════════════════════════════
// BREAKOUT CONDITIONS — SINGLE STOCK (Any Chart)
// Apply to ANY stock — checks Daily & Weekly breakout conditions:
//  C1: Max(5, close) > Max(120D, close)[6 days ago] x multiplier
//  C2: Close > Previous Period Close
//  C3: Volume > SMA(Volume, 20)
//  C4: RSI(14) > 50
// ════════════════════════════════════════════════════════════════
//@version=6
indicator("Breakout Conditions | D and W", shorttitle="BO CHECK", overlay=false, max_bars_back=500)

// ══════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════
grp_s = "== CONDITION SETTINGS =="
mult_in    = input.float(1.04, "Breakout Multiplier", minval=1.0, maxval=1.3, step=0.01, group=grp_s, tooltip="C1: 5-bar high must be above 120D reference high x this factor. 1.04 = 4% above.")
lb_slow_d  = input.int(120,   "Slow Lookback Daily (bars)",  minval=20,  maxval=500, group=grp_s, tooltip="120 daily bars = ~6 months of data.")
slow_off_d = input.int(6,     "Slow Offset Daily (bars)",    minval=0,   maxval=20,  group=grp_s, tooltip="6 = check the 120D high as of 6 days ago.")
lb_slow_w  = input.int(24,    "Slow Lookback Weekly (bars)", minval=4,   maxval=200, group=grp_s, tooltip="24 weeks = approx 120 trading days.")
slow_off_w = input.int(1,     "Slow Offset Weekly (bars)",   minval=0,   maxval=10,  group=grp_s, tooltip="1 = check the 24W high as of 1 week ago.")

grp_d = "== DISPLAY =="
box_pos  = input.string("Top Left", "Dashboard Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=grp_d)
txt_sz   = input.string("Normal",   "Text Size",          options=["Tiny", "Small", "Normal"], group=grp_d)
show_rsi = input.bool(true, "Show RSI Plot", group=grp_d)

_bpos = box_pos == "Top Right" ? position.top_right : box_pos == "Bottom Left" ? position.bottom_left : box_pos == "Bottom Right" ? position.bottom_right : position.top_left
_tsz  = txt_sz == "Tiny" ? size.tiny : txt_sz == "Normal" ? size.normal : size.small

// ══════════════════════════════════════════════════════════════
// CORE FUNCTION
// ══════════════════════════════════════════════════════════════
f_check(lb_s, off_s, mult_) =>
    _h5    = ta.highest(close, 5)
    _hbase = ta.highest(close, lb_s)[off_s]
    _c1    = _h5 > _hbase * mult_
    _c2    = close > close[1]
    _c3    = volume > ta.sma(volume, 20)
    _rsi   = ta.rsi(close, 14)
    _c4    = _rsi > 50.0
    _pass  = _c1 and _c2 and _c3 and _c4
    [_c1, _c2, _c3, _c4, _pass, _h5, _hbase, _rsi, close, volume, ta.sma(volume, 20)]

// ══════════════════════════════════════════════════════════════
// SECURITY CALLS
// ══════════════════════════════════════════════════════════════
[dc1, dc2, dc3, dc4, d_pass, d_h5, d_hbase, d_rsi, d_close, d_vol, d_vsma] = request.security(syminfo.tickerid, "D", f_check(lb_slow_d, slow_off_d, mult_in), lookahead=barmerge.lookahead_off)
[wc1, wc2, wc3, wc4, w_pass, w_h5, w_hbase, w_rsi, w_close, w_vol, w_vsma] = request.security(syminfo.tickerid, "W", f_check(lb_slow_w, slow_off_w, mult_in), lookahead=barmerge.lookahead_off)

// ══════════════════════════════════════════════════════════════
// ALERT CONDITIONS
// ══════════════════════════════════════════════════════════════
alertcondition(d_pass, "Daily Breakout All Conditions",     "Daily Breakout: All 4 PASS on {{ticker}}")
alertcondition(w_pass, "Weekly Breakout All Conditions",    "Weekly Breakout: All 4 PASS on {{ticker}}")
alertcondition(d_pass and w_pass, "D+W Confluence Breakout","D+W Breakout Confluence on {{ticker}}!")
alertcondition(dc1,    "Daily C1 New High Breakout",        "C1 PASS: Daily 5-bar High above 120D Reference on {{ticker}}")
alertcondition(wc1,    "Weekly C1 New High Breakout",       "C1 PASS: Weekly 5-bar High above 24W Reference on {{ticker}}")

// ══════════════════════════════════════════════════════════════
// RSI PLOT
// ══════════════════════════════════════════════════════════════
_rsi_live = ta.rsi(close, 14)
plot(show_rsi ? _rsi_live : na, "RSI(14)", color=color.new(color.purple, 20), linewidth=2)
hline(50, "RSI 50", color=color.new(color.gray, 40),  linestyle=hline.style_dashed)
hline(70, "RSI 70", color=color.new(color.red,  50),  linestyle=hline.style_dotted)
hline(30, "RSI 30", color=color.new(color.lime, 50),  linestyle=hline.style_dotted)
bgcolor(_rsi_live > 50 ? color.new(color.lime, 97) : color.new(color.red, 97))

// ══════════════════════════════════════════════════════════════
// COLORS
// ══════════════════════════════════════════════════════════════
C_GRN_BG  = color.new(#1b5e20, 10)
C_GRN_TXT = color.new(#00e676, 0)
C_RED_BG  = color.new(#7f0000, 20)
C_RED_TXT = color.new(#ff5252, 0)
C_AMB_BG  = color.new(#e65100, 20)
C_AMB_TXT = color.new(#ffd600, 0)
C_HDR_BG  = color.new(#1a237e, 0)
C_TTL_BG  = color.new(#0d1441, 0)
C_NO_BG   = color.new(#080818, 10)
C_WHITE   = color.white
C_GOLD    = color.new(#ffd700, 0)
C_DIM     = color.new(color.white, 55)

// ══════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════════
_fmt(v)  => str.tostring(v, "#.##")
_fmtv(v) => v >= 1e7 ? str.tostring(v / 1e7, "#.##") + " Cr" : v >= 1e5 ? str.tostring(v / 1e5, "#.##") + " L" : str.tostring(v, "#")

f_row(t, c, r, lbl, pass, detail, sz) =>
    _bg = pass ? C_GRN_BG : C_RED_BG
    _tc = pass ? C_GRN_TXT : C_RED_TXT
    _ic = pass ? "YES " : "NO  "
    table.cell(t, c,     r, lbl,          text_color=C_WHITE, bgcolor=C_HDR_BG, text_size=sz, text_halign=text.align_left)
    table.cell(t, c + 1, r, _ic + detail, text_color=_tc,     bgcolor=_bg,      text_size=sz, text_halign=text.align_right)

// ══════════════════════════════════════════════════════════════
// TABLE
// ══════════════════════════════════════════════════════════════
var table tb = table.new(_bpos, 6, 7, border_width=1, border_color=color.new(color.gray, 65), frame_width=2, frame_color=color.new(#ff6d00, 25))

if barstate.islast
    // Calculate Status and Scores First
    _ds = (dc1 ? 1 : 0) + (dc2 ? 1 : 0) + (dc3 ? 1 : 0) + (dc4 ? 1 : 0)
    _ws = (wc1 ? 1 : 0) + (wc2 ? 1 : 0) + (wc3 ? 1 : 0) + (wc4 ? 1 : 0)
    _ts = _ds + _ws

    _ds_bg = _ds == 4 ? C_GRN_BG : _ds >= 2 ? C_AMB_BG : C_RED_BG
    _ds_tc = _ds == 4 ? C_GRN_TXT : _ds >= 2 ? C_AMB_TXT : C_RED_TXT

    _ws_bg = _ws == 4 ? C_GRN_BG : _ws >= 2 ? C_AMB_BG : C_RED_BG
    _ws_tc = _ws == 4 ? C_GRN_TXT : _ws >= 2 ? C_AMB_TXT : C_RED_TXT

    _ts_bg = _ts >= 7 ? C_GRN_BG : _ts >= 5 ? C_AMB_BG : C_RED_BG
    _ts_tc = _ts >= 7 ? C_GRN_TXT : _ts >= 5 ? C_AMB_TXT : C_RED_TXT

    _status = (d_pass and w_pass) ? "BOTH D+W PASS" : d_pass ? "DAILY PASS" : w_pass ? "WEEKLY PASS" : "WATCHING"
    _s_tc   = (d_pass and w_pass) ? C_GOLD : d_pass ? C_GRN_TXT : w_pass ? C_AMB_TXT : C_DIM

    _slbl = (d_pass and w_pass) ? "STRONG \u2014 D+W Both Pass" : d_pass ? "MODERATE \u2014 Daily Only" : w_pass ? "MODERATE \u2014 Weekly Only" : _ts >= 5 ? "NEAR \u2014 Watch Closely" : "NEUTRAL \u2014 Not Ready"
    _sbg  = (d_pass and w_pass) ? color.new(#ff6d00, 20) : (d_pass or w_pass) ? C_AMB_BG : C_NO_BG
    _stc  = (d_pass and w_pass) ? C_GOLD : (d_pass or w_pass) ? C_AMB_TXT : C_DIM

    // Row 0: Top Headers
    table.cell(tb, 0, 0, "BO CHECK: " + syminfo.ticker, text_color=C_WHITE, bgcolor=C_TTL_BG, text_size=_tsz, text_halign=text.align_center)
    table.cell(tb, 2, 0, "Mult: x" + str.tostring(mult_in, "#.##") + " | C1=High C2=Close C3=Vol C4=RSI", text_color=C_DIM, bgcolor=C_TTL_BG, text_size=size.tiny, text_halign=text.align_center)
    table.cell(tb, 4, 0, "STATUS: " + _status, text_color=_s_tc, bgcolor=C_TTL_BG, text_size=_tsz, text_halign=text.align_center)

    // Merge Header Cells
    table.merge_cells(tb, 0, 0, 1, 0)
    table.merge_cells(tb, 2, 0, 3, 0)
    table.merge_cells(tb, 4, 0, 5, 0)

    // Row 1: Section Headers
    _d_all_txt = d_pass ? "ALL PASS" : "NOT ALL"
    _d_all_bg  = d_pass ? C_GRN_BG  : C_RED_BG
    _d_all_tc  = d_pass ? C_GRN_TXT : C_RED_TXT
    table.cell(tb, 0, 1, "DAILY CONDITIONS",  text_color=C_GRN_TXT, bgcolor=color.new(#1a237e, 30), text_size=_tsz, text_halign=text.align_left)
    table.cell(tb, 1, 1, _d_all_txt,          text_color=_d_all_tc, bgcolor=_d_all_bg,              text_size=_tsz, text_halign=text.align_right)

    _w_all_txt = w_pass ? "ALL PASS" : "NOT ALL"
    _w_all_bg  = w_pass ? C_GRN_BG  : C_RED_BG
    _w_all_tc  = w_pass ? C_GRN_TXT : C_RED_TXT
    table.cell(tb, 2, 1, "WEEKLY CONDITIONS", text_color=C_AMB_TXT, bgcolor=color.new(#1a237e, 30), text_size=_tsz, text_halign=text.align_left)
    table.cell(tb, 3, 1, _w_all_txt,          text_color=_w_all_tc, bgcolor=_w_all_bg,              text_size=_tsz, text_halign=text.align_right)

    table.cell(tb, 4, 1, "SUMMARY", text_color=C_GOLD, bgcolor=color.new(#ff6d00, 30), text_size=_tsz, text_halign=text.align_left)
    table.cell(tb, 5, 1, "",        bgcolor=color.new(#ff6d00, 30))
    table.merge_cells(tb, 4, 1, 5, 1) // Merging Summary title across its 2 columns

    // Row 2: Condition 1 & Signal
    f_row(tb, 0, 2, "C1 - 5D High > 120D High x" + str.tostring(mult_in, "#.##"), dc1, _fmt(d_h5) + " vs " + _fmt(d_hbase * mult_in), _tsz)
    f_row(tb, 2, 2, "C1 - 5W High > 24W High x" + str.tostring(mult_in, "#.##"), wc1, _fmt(w_h5) + " vs " + _fmt(w_hbase * mult_in), _tsz)
    table.cell(tb, 4, 2, "SIGNAL",  text_color=C_WHITE, bgcolor=C_HDR_BG, text_size=_tsz, text_halign=text.align_left)
    table.cell(tb, 5, 2, _slbl,     text_color=_stc,    bgcolor=_sbg,     text_size=_tsz, text_halign=text.align_right)

    // Row 3: Condition 2 & Daily Score (Summary)
    f_row(tb, 0, 3, "C2 - Close > Prev Day Close",  dc2, _fmt(d_close) + " vs prev", _tsz)
    f_row(tb, 2, 3, "C2 - Close > Prev Week Close", wc2, _fmt(w_close) + " vs prev week", _tsz)
    table.cell(tb, 4, 3, "DAILY SCORE",  text_color=C_WHITE, bgcolor=C_HDR_BG, text_size=_tsz, text_halign=text.align_left)
    table.cell(tb, 5, 3, str.tostring(_ds) + "/4", text_color=_ds_tc, bgcolor=_ds_bg, text_size=_tsz, text_halign=text.align_right)

    // Row 4: Condition 3 & Weekly Score (Summary)
    f_row(tb, 0, 4, "C3 - Volume > SMA(Volume,20)", dc3, _fmtv(d_vol) + " vs " + _fmtv(d_vsma), _tsz)
    f_row(tb, 2, 4, "C3 - Volume > SMA(Volume,20)", wc3, _fmtv(w_vol) + " vs " + _fmtv(w_vsma), _tsz)
    table.cell(tb, 4, 4, "WEEKLY SCORE", text_color=C_WHITE, bgcolor=C_HDR_BG, text_size=_tsz, text_halign=text.align_left)
    table.cell(tb, 5, 4, str.tostring(_ws) + "/4", text_color=_ws_tc, bgcolor=_ws_bg, text_size=_tsz, text_halign=text.align_right)

    // Row 5: Condition 4 & Total Score (Summary)
    f_row(tb, 0, 5, "C4 - Daily RSI(14) > 50",      dc4, "RSI=" + str.tostring(d_rsi, "#.##"), _tsz)
    f_row(tb, 2, 5, "C4 - Weekly RSI(14) > 50",     wc4, "RSI=" + str.tostring(w_rsi, "#.##"), _tsz)
    table.cell(tb, 4, 5, "TOTAL SCORE",  text_color=C_WHITE, bgcolor=C_HDR_BG, text_size=_tsz, text_halign=text.align_left)
    table.cell(tb, 5, 5, str.tostring(_ts) + "/8", text_color=_ts_tc, bgcolor=_ts_bg, text_size=_tsz, text_halign=text.align_right)

    // Row 6: Daily Score & Weekly Score (Bottom of Daily & Weekly sections)
    table.cell(tb, 0, 6, "DAILY SCORE",  text_color=C_WHITE, bgcolor=C_HDR_BG, text_size=_tsz, text_halign=text.align_left)
    table.cell(tb, 1, 6, str.tostring(_ds) + " / 4", text_color=_ds_tc, bgcolor=_ds_bg, text_size=_tsz, text_halign=text.align_right)
    table.cell(tb, 2, 6, "WEEKLY SCORE", text_color=C_WHITE, bgcolor=C_HDR_BG, text_size=_tsz, text_halign=text.align_left)
    table.cell(tb, 3, 6, str.tostring(_ws) + " / 4", text_color=_ws_tc, bgcolor=_ws_bg, text_size=_tsz, text_halign=text.align_right)
    
    // Blank out the bottom Summary section
    table.cell(tb, 4, 6, "", bgcolor=C_NO_BG)
    table.cell(tb, 5, 6, "", bgcolor=C_NO_BG)
    table.merge_cells(tb, 4, 6, 5, 6)
